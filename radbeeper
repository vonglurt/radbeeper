def f(places, v):
    """"%.*f", which rounds half to even exactly as Rust's {:.*} does."""
    return "%.*f" % (places, v)


def exact(v):
    """The shortest text that reads back as this float.

    MATCHES RUST'S `{}` FOR f64, which is the point of it: this number goes
    into a file that is compared byte for byte against the one the Rust
    writes. The one place the two would otherwise differ is a whole number --
    Rust prints `34`, Python's repr prints `34.0` -- so that case is handled
    and the rest is repr, which is shortest-round-trip in both languages.
    """
    if v != v or v in (float("inf"), float("-inf")):
        return ""
    if v == int(v) and abs(v) < 1e16:
        return str(int(v))
    return repr(v)


# The five bands, and their floors in CPM. THE SAME FIVE the dial in
# radbeeper-gui and the legend on the monitor page use, and the same five
# src/analysis.rs defines -- a viewer with its own thresholds would be a third
# opinion about what counts as a warning, which is the one thing an instrument
# must not have.
#
# NOTE THE FLOOR OF `nominal` IS 30 AND NOT 0. Between 3 and 30 is where a
# counter reads when something is between it and the world, and calling that
# "nominal" would be the most dangerous thing this scale could do: an
# instrument reading low because it has FAILED must not look like an
# instrument reading low because the room is clean.
BAND_NOMINAL = 30.0
BAND_ADVISORY = 120.0
BAND_WARNING = 240.0
BAND_DEADLY = 600.0


def band_name(cpm):
    """The band a reading falls in. Mirrors analysis::band()."""
    if cpm >= BAND_DEADLY:
        return "deadly"
    if cpm >= BAND_WARNING:
        return "warning"
    if cpm >= BAND_ADVISORY:
        return "advisory"
    if cpm >= BAND_NOMINAL:
        return "nominal"
    return "attenuated"


# ------------------------------------------------------------------- audit ---
#
# THE DIVISION OF LABOUR THAT LETS THIS PAGE CARRY A FRAME VIEWER. random.html
# is compared byte for byte against the page the Rust writes, and this program
# has never heard of a frame -- there is no RBF1 decoder anywhere below. It
# does not need one. The joined table is built from the emission .tsv and the
# count .tsv, two text formats this program has always read, and the frames go
# into the page as base64 WITHOUT BEING PARSED. The decoding happens in the
# browser, in src/frames.js, where there is exactly one implementation of it.
#
# The chain is computed here, in both languages, because it comes from the
# KEYS in the emission log and not from the frames. That is on purpose: it
# keeps the tamper-evidence inside the differential contract, so this program
# can contradict the Rust about it.

# How many raw bytes of frame data a page embeds before it starts leaving
# months out. Two mebibytes is about three weeks of continuous counting.
DEFAULT_FRAME_BUDGET = 2 * 1024 * 1024

# The label under which chain links are hashed, so a link can never be
# mistaken for a key even if somebody contrives the inputs.
CHAIN_LABEL = b"radbeeper/chain/1"
GENESIS_LINK = "0" * 64

# How far from an emission a count-log row may be and still describe it. The
# service writes a row every thirty seconds by default, so a minute either
# side always finds one when the log was running, and never invents a reading
# for an emission the log was not there for.
JOIN_WINDOW = 60.0


def chain_step(prev, key):
    """One step of the hash chain. Mirrors entropy::chain in the Rust.

    NOT THE RANDOM OUTPUT AND IT MUST NEVER FEED IT. The emission digest is
    label, sequence, start second and counts, and nothing else. Folding the
    previous link into it would make every published hex line unrecomputable
    and would retroactively invalidate every emission already written.
    """
    h = hashlib.sha256()
    h.update(CHAIN_LABEL)
    h.update(bytes.fromhex(prev))
    h.update(bytes.fromhex(key))
    return h.hexdigest()


def parse_bytes(text):
    """A size with an optional K/M/G suffix, as --frame-budget takes it.

    `0` is meaningful and is not an error: it asks for a page that embeds no
    frames at all, which is what somebody publishing a very long record and
    linking the files instead actually wants.
    """
    t = str(text).strip()
    scale = 1
    if t[-1:] in ("k", "K"):
        t, scale = t[:-1], 1024
    elif t[-1:] in ("m", "M"):
        t, scale = t[:-1], 1024 * 1024
    elif t[-1:] in ("g", "G"):
        t, scale = t[:-1], 1024 * 1024 * 1024
    try:
        return int(t.strip()) * scale
    except ValueError:
        raise argparse.ArgumentTypeError("not a size: %r" % (text,))


def bare_audit():
    """An audit page for a counter with nothing recorded about it."""
    return {"place": "", "fix": "", "joined": "", "frames": "",
            "embedded": [], "files": [], "siblings": []}


def audit_summary(audit):
    """The line the viewer prints above itself."""
    files, embedded = len(audit["files"]), len(audit["embedded"])
    return ("%d emission file%s on record; %d month%s of raw seconds carried "
            "in this page." % (files, "" if files == 1 else "s",
                               embedded, "" if embedded == 1 else "s"))


def bytes_text(n):
    """`n` bytes, as a person reads them."""
    if n >= 1024 * 1024:
        return "%s MiB" % f(1, n / (1024.0 * 1024.0))
    if n >= 1024:
        return "%s KiB" % f(1, n / 1024.0)
    return "%d B" % n


def esc_payload(text):
    """A payload's text, made safe to sit inside a <script> element.

    THE ONLY SEQUENCE THAT MATTERS IS `</`. Inside a <script> the HTML parser
    is not looking for entities -- escaping `&` or `"` here would corrupt the
    data, since the browser hands it back verbatim -- it is looking for the
    end of the element, which any `</` can start. Breaking that one digraph is
    necessary and sufficient, and the viewer puts it back.
    """
    return text.replace("</", "<\\/")


def json_str(text):
    """A JSON string literal, with the two escapes a <script> payload needs."""
    out = ['"']
    for c in text:
        if c == '"':
            out.append('\\"')
        elif c == "\\":
            out.append("\\\\")
        elif c == "\n":
            out.append("\\n")
        elif c == "\r":
            out.append("\\r")
        elif c == "\t":
            out.append("\\t")
        elif c == "<":
            out.append("\\u003c")
        elif ord(c) < 0x20:
            out.append("\\u%04x" % ord(c))
        else:
            out.append(c)
    out.append('"')
    return "".join(out)


def json_meta(serial, audit):
    """The meta block the viewer reads: strings only, none of them user HTML."""
    return ('{"version":%s,"serial":%s,"place":%s,"fix":%s,"summary":%s}'
            % (json_str(VERSION), json_str(serial), json_str(audit["place"]),
               json_str(audit["fix"]), json_str(audit_summary(audit))))


def log_series(directory, serial):
    """[(time, cpm_30)] for one counter, oldest first."""
    out = []
    for s, path in log_files(directory):
        if s != serial:
            continue
        try:
            f = open(path)
        except IOError:
            continue
        with f:
            cpm30 = None
            for line in f:
                if line.startswith("#"):
                    # A file can carry more than one header, where the windows
                    # changed mid-month; the column is found by NAME under the
                    # last header seen, never by position.
                    head = line[1:].rstrip("\n").split("\t")
                    cpm30 = head.index("cpm_30") if "cpm_30" in head else None
                    continue
                if not line.strip():
                    continue
                cells = line.rstrip("\n").split("\t")
                when = row_time(line)
                if cpm30 is None or when is None or cpm30 >= len(cells):
                    continue
                try:
                    out.append((when, float(cells[cpm30])))
                except ValueError:
                    continue
    out.sort(key=lambda r: r[0])
    return out


def nearest_reading(series, when):
    """The logged 30s average at that moment, or None if nothing is near."""
    import bisect
    if not series:
        return None
    times = [r[0] for r in series]
    i = bisect.bisect_left(times, when)
    best = None
    for j in (i - 1, i, i + 1):
        if 0 <= j < len(series):
            d = abs(series[j][0] - when)
            if d <= JOIN_WINDOW and (best is None or d < best[0]):
                best = (d, series[j][1])
    return None if best is None else best[1]


def join_emissions(directory, serial, pools, cpm_per_usvh):
    """Every emission for one counter, chained and joined to the count log."""
    series = log_series(directory, serial)
    rows = []
    prev = GENESIS_LINK
    for p in pools:
        counts = sum(p["counts"])
        cpm = p["rate"] * 60.0
        when = row_time(p["time"] + "\t")
        prev = chain_step(prev, p["hex"])
        rows.append({
            "seq": p["seq"], "started": p["time"], "samples": p["seconds"],
            "counts": counts, "cpm": cpm,
            "usvh": (cpm / cpm_per_usvh) if cpm_per_usvh > 0 else 0.0,
            "bits": p["bits"], "flat": p["flat"],
            "band": band_name(cpm),
            "log_cpm": nearest_reading(series, when) if when is not None else None,
            "key": p["hex"], "link": prev,
        })
    return rows


def joined_tsv(rows, head):
    """The joined table as the file the page links and the viewer reads."""
    out = ["# " + line for line in head]
    out.append("#seq\tstarted\tsamples\tcounts\tcpm\tusvh\tbits\tflat\t"
               "band\tlog_cpm\tkey\tlink")
    for r in rows:
        out.append("\t".join([
            str(r["seq"]), r["started"], str(r["samples"]), str(r["counts"]),
            exact(round(r["cpm"], 4)), exact(round(r["usvh"], 6)),
            exact(round(r["bits"], 4)), "yes" if r["flat"] else "no",
            r["band"],
            "--" if r["log_cpm"] is None else exact(round(r["log_cpm"], 1)),
            r["key"], r["link"],
        ]))
    return "\n".join(out) + "\n"


def frames_to_embed(directory, serial, budget):
    """The frame files to embed, newest first, stopping before the budget.

    WHOLE FILES AND NOT A BYTE COUNT INTO ONE, because this program cannot
    see where a frame ends -- it is copying bytes it does not parse. A month
    is a unit both implementations agree on without either understanding the
    contents.
    """
    taken, total = [], 0
    for path in reversed(random_series(directory, serial, "bin")):
        try:
            size = os.path.getsize(path)
        except OSError:
            continue
        if size == 0:
            continue
        # The newest file goes in even when it is over budget on its own: a
        # page with no frames at all is worse than a heavy one.
        if taken and total + size > budget:
            break
        total += size
        taken.append(path)
    taken.reverse()
    return taken


def frames_bytes(paths):
    """Those files' bytes, concatenated in order."""
    out = b""
    for p in paths:
        try:
            with open(p, "rb") as f:
                out += f.read()
        except IOError:
            pass
    return out


def random_series(directory, serial, ext):
    """Every emission file of one extension for one counter, oldest first.

    The undated random-<serial>.<ext> written before 0.5 sorts FIRST and is
    read as though it were the oldest month, because it is. Nothing migrates
    it: a file somebody may have published the hash of is not a file to
    rewrite.
    """
    serial = serial or "unknown"
    head, tail = "random-" + serial, "." + ext
    dated, legacy = [], None
    try:
        names = os.listdir(directory)
    except OSError:
        return []
    for name in names:
        if not name.startswith(head) or not name.endswith(tail):
            continue
        middle = name[len(head):len(name) - len(tail)]
        if middle == "":
            legacy = name
        elif is_dash_month(middle):
            dated.append(name)
    dated.sort()
    out = ([os.path.join(directory, legacy)] if legacy else [])
    return out + [os.path.join(directory, n) for n in dated]


def is_dash_month(text):
    """Whether `text` is exactly -YYYY-MM.

    Checked rather than assumed, so that a serial containing a dash cannot
    make random-AB-CD.tsv look like a dated file for counter AB.
    """
    return (len(text) == 8 and text[0] == "-" and text[5] == "-"
            and text[1:5].isdigit() and text[6:].isdigit())


def audit_downloads(directory, serial):
    """Every emission file for a counter, as (name, bytes), for the page."""
    out = {}
    for ext in ("tsv", "hex", "bin"):
        for path in random_series(directory, serial, ext):
            try:
                size = os.path.getsize(path)
            except OSError:
                continue
            if size:
                out[os.path.basename(path)] = size
    return sorted(out.items())


