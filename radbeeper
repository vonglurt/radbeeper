# PORT: replaced by src/analysis.rs :: Windows -- new/add/elapsed/average keep their names and the same running sums
class Windows:
    """Counts per second in, three running CPM averages out.

    A deque per window would be three copies of the same data. One list of
    (time, counts) covering the longest window serves all three.

    EACH WINDOW KEEPS A RUNNING SUM rather than re-adding its samples. The
    obvious version -- sum the tail on every call -- is O(samples x window),
    which nobody notices at one sample a second and which cost sixteen and a
    half seconds when a backfill pushed 850,000 samples through it: 765
    million additions to produce 28,000 rows. Adding the new sample and
    subtracting the ones that fell out the back is O(1) per window per sample,
    and the same work drops to under a second. The number that made this worth
    doing was measured, not guessed.
    """

    def __init__(self, spans=(3, 30, 300, 3000, 30000)):
        self.spans = tuple(spans)
        self.longest = max(self.spans)
        self.samples = []
        self.total = 0
        self.started = None
        # Per span: the running sum, and an absolute index of the oldest
        # sample still inside it. Absolute, because the front of the list is
        # discarded as it ages -- `base` is how many have gone.
        self.sums = [0] * len(self.spans)
        self.heads = [0] * len(self.spans)
        self.base = 0

    def add(self, when, counts):
        if self.started is None:
            self.started = when
        self.samples.append((when, counts))
        self.total += counts
        for i, span in enumerate(self.spans):
            self.sums[i] += counts
            cutoff = when - span
            head = self.heads[i]
            while head - self.base < len(self.samples):
                t, c = self.samples[head - self.base]
                if t > cutoff:
                    break
                self.sums[i] -= c
                head += 1
            self.heads[i] = head
        # Discard what no window can still reach. One sample beyond the
        # longest is kept so a full window is recognisable.
        keep = min(self.heads) - 1
        if keep > self.base:
            del self.samples[:keep - self.base]
            self.base = keep

    def elapsed(self):
        if self.started is None:
            return 0.0
        return self.samples[-1][0] - self.started

    def average(self, span):
        """CPM over the last span seconds, or None until the window is full.

        None is not a failure and must not be drawn as zero: it means "not
        enough signal yet to say", and the difference matters most in the
        first five minutes, which is exactly when someone is watching.
        """
        if not self.samples or self.elapsed() < span:
            return None
        return self.sums[self.spans.index(span)] * 60.0 / span

    def usvh(self, span, cpm_per_usvh):
        cpm = self.average(span)
        if cpm is None or cpm_per_usvh <= 0:
            return None
        return cpm / cpm_per_usvh


# PORT: replaced by src/log.rs :: Interval -- new/reset/add/cps, the per-row accumulator between log writes
class Interval:
    """What happened between two log lines, in constant space.

    The peaks are the reason this class exists. A row written every 30 seconds
    carrying only the averages as they stood at the moment of writing would
    miss a source that came and went in between -- which is the single event
    most worth having in a log afterwards. Keeping a running maximum per window
    costs one comparison a second and no memory that grows, so the interesting
    moment survives without storing the seconds it happened in.

    Nothing here accumulates: counts and seconds are integers, the peaks are
    one float per window, and reset() puts it back to empty. A month of logging
    uses exactly as much memory as the first minute.
    """

    __slots__ = ("spans", "counts", "seconds", "peaks")

    def __init__(self, spans):
        self.spans = tuple(spans)
        self.reset()

    def reset(self):
        self.counts = 0
        self.seconds = 0.0
        self.peaks = [None] * len(self.spans)

    def add(self, counts, averages, dt=1.0):
        """One sample: the raw count, each window as it stands, and how long
        the sample covers.

        dt is 1.0 from the heartbeat, which is a second by definition. It is
        NOT 1.0 when the samples come from the counter's flash, where a
        recorded "second" measures 1.011 of ours -- and a column that says
        `seconds` has to mean seconds, or the cps beside it is a percent wrong
        for no visible reason.
        """
        self.counts += counts
        self.seconds += dt
        for i, cpm in enumerate(averages):
            if cpm is not None and (self.peaks[i] is None or cpm > self.peaks[i]):
                self.peaks[i] = cpm

    def cps(self):
        """Counts per ONE second, whatever the interval's length.

        The interval is 30 seconds by default and the log must not imply that
        the number in this column is 30 seconds' worth: CPS means per second
        here and everywhere else, so the divisor is the elapsed seconds and
        never the row spacing.
        """
        if not self.seconds:
            return 0.0
        return self.counts / float(self.seconds)


