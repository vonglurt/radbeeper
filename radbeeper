        if (state.minCpm !== null && (r.cpm === null || r.cpm < state.minCpm)) continue;
        if (state.maxCpm !== null && (r.cpm === null || r.cpm > state.maxCpm)) continue;
        if (state.bands && r.band.name !== state.bands) continue;
