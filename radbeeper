# -------------------------------------------------------------- recompute ---
#
# A WINDOW LONGER THAN THE ROW SPACING IS ALREADY IN THE FILE. Every row
# carries `counts` and `seconds`, so the mean rate over any stretch of rows is
# their sum divided by their sum -- no per-second data needed. Adding a 3000
# second window to a program that has been logging for a fortnight therefore
# does not mean waiting a fortnight: the column can be filled backwards from
# what is on disk.
#
# WHAT CANNOT BE RECOVERED, and is left empty rather than guessed:
#
#   * Anything SHORTER than the row spacing. A 3-second window inside a
#     30-second row is not in the file at any resolution, and averaging the
#     row down to it would be inventing structure.
#   * The PEAKS. peak_N is the highest the window reached at any instant
#     between two rows; the file records where it got to, not the path it
#     took. The maximum of the row-level averages is a different and smaller
#     quantity, and writing it into a column that means something else would
#     be worse than leaving the column empty.
#   * Any window whose rows are not contiguous. A gap means the counter was
#     not recording, and a mean across it would average two different
#     afternoons and call it one number.
# PORT: NOT PORTED. `recompute` is still Python.
def recompute_rows(rows, spans, max_gap):
    """Fill empty window cells from the counts already in the rows.

    `rows` is a list of already-split cell lists. Returns how many cells were
    filled. Cells that hold a measurement are never touched.
    """
    width = 4 + 2 * len(spans) + 2
    times, counts, seconds = [], [], []
    for cells in rows:
        when = row_time("\t".join(cells))
        try:
            counts.append(int(cells[2]))
            seconds.append(float(cells[3]))
        except (IndexError, ValueError):
            counts.append(0)
            seconds.append(0.0)
        times.append(when if when is not None else 0.0)

    filled = 0
    for i in range(len(rows)):
        for k, span in enumerate(spans):
            col = 4 + k
            if col >= len(rows[i]) or rows[i][col]:
                continue          # measured, or the row is too short
            if span <= seconds[i]:
                continue          # finer than the file records
            total_c, total_s = 0, 0.0
            j = i
            ok = True
            while j >= 0 and total_s < span:
                if j < i:
                    # Contiguous? The next row must start where this one ended.
                    hole = times[j + 1] - (times[j] + seconds[j])
                    if hole > max_gap:
                        ok = False
                        break
                total_c += counts[j]
                total_s += seconds[j]
                j -= 1
            if not ok or total_s < span or total_s <= 0:
                continue          # the window is not covered: leave it empty
            rows[i][col] = "%.1f" % (total_c * 60.0 / total_s)
            filled += 1
    return filled, width


