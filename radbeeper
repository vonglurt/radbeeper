    samples = [x for p in pools for x in p["counts"]]
    b = entropy_budget(samples)
    out = page_head(title, RANDOM_CSS)
    a = out.append
    a("<h1>" + esc(title) + "</h1>")
    a('<p class="sub">radbeeper ' + VERSION + " &middot; counter "
