    rows = 0
    with open(csv_path, "w") as f:
        f.write("offset,time,interval_s,count,note\n")
        for off, when, dt, count, note in history_records(got):
            f.write("%d,%s,%s,%s,%s\n"
                    % (off,
                       "" if when is None else time.strftime(
                           "%Y-%m-%dT%H:%M:%S", time.localtime(when)),
                       "" if dt is None else "%.4f" % dt,
                       "" if count is None else count,
                       note.replace(",", " ")))
            rows += 1
    print("csv    %s  (%d rows)" % (csv_path, rows))
    print("       times are the COUNTER's clock; interval_s is the measured")
    print("       spacing of its samples. radbeeper backfill corrects both.")
    if rows == 0:
        print("nothing was recorded -- the counter's history may be empty.")
    return 0


# --------------------------------------------------------------- the log ---
#
# ONE ROW PER SLOT, AND THE SLOT IS THE KEY. Rows arrive from two places --
# the live monitor, and a backfill reading the counter's flash -- and they must
# not be able to describe the same stretch of time twice. So a row is not
# identified by its timestamp, which is whatever instant the writer happened to
# reach, but by the SLOT it falls in: the log interval it belongs to, floor of
# the time over the row spacing. Two rows clash if and only if they share a
# slot, and a backfill never writes into a slot that already has a row.
#
# GAPS ARE ALLOWED AND ARE NOT FILLED. A slot with no evidence stays absent
# from the file. Nothing is interpolated across it, because a row that says
# 0.000 CPS for a half hour nobody measured is worse than no row at all -- it
# is the same mistake as drawing an unfilled window as zero, one file down.
def log_header(spans):
    head = ["time", "cps", "counts", "seconds"]
    head += ["cpm_%g" % s for s in spans]
    head += ["peak_%g" % s for s in spans]
    head.append("src")
    # The place, resolved at the row's own time: a counter that moved
    # mid-month leaves a file whose rows are not all from one site, and a row
    # that cannot say where it was is half a measurement.
    head.append("site")
    # The '#' keeps the header sorting above the rows rather than into the
    # middle of them, so `sort` stays usable on the file as it is, and
    # `grep -v '^#'` drops it when it is in the way.
    return "#" + "\t".join(head)


def log_row(when, cps, counts, seconds, averages, peaks, src, site=""):
    """One tab-separated line: when, how fast, the worst it got, and whence.

    The timestamp is first and is written big-endian, so it sorts
    lexicographically: `sort cpm.tsv` is chronological with no flags, no field
    numbers and no awk, which is the whole reason for that shape.
    """
    cells = [time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(when)),
             "%.3f" % cps, "%d" % counts, "%g" % seconds]
    cells += ["" if a is None else "%.1f" % a for a in averages]
    cells += ["" if p is None else "%.1f" % p for p in peaks]
    cells.append(src)
    cells.append(site or "")
    return "\t".join(cells)


def read_sites(directory=None):
    """[(serial, from_time, name)], oldest first."""
    path = os.path.join(directory or state_dir(), SITES_NAME)
    out = []
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                cells = line.split("\t")
                if len(cells) < 3:
                    continue
                when = row_time(cells[1] + "\t")
                if when is None:
                    continue
                out.append((cells[0], when, cells[2]))
    except IOError:
        pass
    out.sort(key=lambda r: (r[0], r[1]))
    return out


def site_at(serial, when, sites):
    """Where that counter was at that moment.

    Readings older than the first thing written down belong to the first place
    we know about, not to nowhere: the counter was somewhere, and the earliest
    record is the best evidence of where. Everything after a move belongs to
    the place it moved to.
    """
    mine = [r for r in sites if r[0] == serial]
    if not mine:
        return None
    current = mine[0]
    for row in mine:
        if row[1] <= when:
            current = row
    return current


def record_site(serial, name, when=None, directory=None):
    """Append a move. Append-only, because it is a history and not a setting."""
    d = directory or state_dir()
    path = os.path.join(d, SITES_NAME)
    fresh = not os.path.exists(path) or os.path.getsize(path) == 0
    with open(path, "a") as f:
        if fresh:
            f.write("#serial\tfrom\tname\n")
        # `when` is 0 for the record that covers a counter's whole history,
        # and 0 is falsy -- so this asks whether it was given, not whether it
        # is true, which is the difference between "from the start" and "from
        # the moment somebody first ran this".
        stamp = time.time() if when is None else when
        f.write("%s\t%s\t%s\n"
                % (serial, time.strftime("%Y-%m-%dT%H:%M:%S",
                                         time.localtime(stamp)), name))
    return path


def ensure_site(serial, directory=None):
    """A counter seen for the first time is written down where it started."""
    sites = read_sites(directory)
    if any(r[0] == serial for r in sites):
        return sites
    # Dated well before any reading, so it covers the whole of the counter's
    # history rather than only what comes after this moment.
    record_site(serial, DEFAULT_SITE, when=0, directory=directory)
    return read_sites(directory)


def log_path(when, directory=None, serial=None):
    """The dated log a row belongs in: one file per counter per month.

    THE SERIAL IS IN THE NAME because two counters on one machine are two
    measurements, not one, and a file that mixed them would be unmixable
    afterwards. Same argument as the month: a distinction that matters is
    better made by which file a row goes in than by a column somebody has to
    remember to filter on.

    ROTATION BY CONSTRUCTION, WHICH IS WHY THERE IS NO ROTATION CODE. A row is
    written to the file for its own month, so a month ending is not an event:
    that file simply stops growing and the next one starts. Nothing has to be
    scheduled, nothing renames a file while a service is appending to it, and
    there is no window where a log is half-moved. It is also the only shape
    that suits a backfill, which routinely carries rows for months that ended
    weeks ago and would otherwise need to know what had already been rotated.

    The names sort chronologically, so `sort cpm-*.tsv` is still one
    chronological stream across the whole archive -- the same promise the row
    format makes within one file.
    """
    return os.path.join(
        directory or state_dir(),
        "cpm-%s-%s.tsv" % (serial or "unknown",
                           time.strftime("%Y-%m", time.localtime(when))))


def fit_row(line, width):
    """An older row widened to the current format.

    Rows written before the src column existed were all measured live, so
    that is what they are marked. Anything of an unexpected width is left
    exactly as found: a log is somebody's data and a format guess is not worth
    editing it over.
    """
    cells = line.split("\t")
    if len(cells) >= width:
        return line
    # src was added first and site second, so a short row is missing a suffix
    # of the columns and padding on the right restores the right meaning.
    while len(cells) < width:
        cells.append(SRC_LIVE if len(cells) == width - 2 else "")
    return "\t".join(cells)


def slot_of(when, every):
    """The slot a time falls in. This is a row's identity -- see above."""
    return int(when // every)


def row_time(line):
    """The unix time a written row carries, or None if it is not a row."""
    if not line or line.startswith("#"):
        return None
    try:
        return time.mktime(time.strptime(line.split("\t", 1)[0],
                                         "%Y-%m-%dT%H:%M:%S"))
    except (ValueError, IndexError):
        return None


def read_log(path):
    """[(unix time, line)] for an existing log. Missing is empty, not an error."""
    out = []
    try:
        with open(path) as f:
            for line in f:
                line = line.rstrip("\n")
                when = row_time(line)
                if when is not None:
                    out.append((when, line))
    except IOError:
        pass
    return out


def merge_log(path, header, rows, every):
    """Fold rows into the log, one per slot, never over one already there.

    Returns (added, clashed). A clash is not an error and is not a warning: it
    is the ordinary case of backfilling a period that was already logged live,
    and the live row is the better evidence, so it stays.

    The file is rewritten rather than appended to because backfilled rows
    belong in the PAST, and the one property this format promises is that
    plain `sort` on it is chronological. Rewriting is done onto a temporary
    file in the same directory and renamed over the original, so an
    interrupted backfill leaves the old log intact rather than half a new one.
    """
    existing = read_log(path)
    taken = set(slot_of(w, every) for w, _ in existing)
    keep = []
    added = clashed = 0
    for when, line in rows:
        slot = slot_of(when, every)
        if slot in taken:
            clashed += 1
            continue
        taken.add(slot)
        keep.append((when, line))
        added += 1
    if not added:
        return 0, clashed
    width = len(header.split("\t"))
    merged = sorted([(w, fit_row(ln, width)) for w, ln in existing + keep],
                    key=lambda r: r[1])
    tmp = path + ".new"
    with open(tmp, "w") as f:
        f.write(header + "\n")
        for _when, line in merged:
            f.write(line + "\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    return added, clashed


class LogWriter:
    """Appends rows to the dated log for their month.

    Two things it watches for, both once per row and so once per thirty
    seconds -- a stat and a comparison, against the two syscalls the row
    itself costs:

    THE MONTH TURNING OVER, which is the whole of rotation.

    THE FILE BEING REPLACED UNDERNEATH IT. A backfill merges by writing a new
    file and renaming it over the old one, which leaves an appender holding a
    file descriptor onto an orphaned inode: it goes on writing, to nothing
    anybody will ever read. Comparing the inode catches that and reopens.
    """

    def __init__(self, spans, directory=None, serial=None, every=None):
        self.spans = spans
        self.dir = directory
        self.serial = serial
        self.every = every or DEFAULT_LOG_EVERY
        self.path = None
        self.file = None
        self.ino = None
        self.last_slot = None

    def _open(self, path):
        self.close()
        fresh = not os.path.exists(path) or os.path.getsize(path) == 0
        self.file = open(path, "a")
        if fresh:
            self.file.write(log_header(self.spans) + "\n")
        self.path = path
        # The slot already on disk, so a restart cannot append a second row
        # for a slot the previous run finished. That is exactly what happens
        # when a service comes back mid-interval: its first row is a short one
        # covering a stretch the last run already wrote in full.
        rows = read_log(path)
        self.last_slot = slot_of(rows[-1][0], self.every) if rows else None
        try:
            self.ino = os.fstat(self.file.fileno()).st_ino
        except OSError:
            self.ino = None

    def write(self, when, text):
        """Append a row, unless its slot is already spoken for.

        One row per slot is the rule the whole format rests on, and it has to
        hold for the live logger too -- not only for the merge a backfill does.
        Returns whether the row was written.
        """
        path = log_path(when, self.dir, self.serial)
        if path != self.path or self.file is None or self._replaced():
            self._open(path)
        slot = slot_of(when, self.every)
        if self.last_slot is not None and slot <= self.last_slot:
            return False
        self.file.write(text)
        self.file.flush()
        self.last_slot = slot
        return True

    def _replaced(self):
        try:
            return os.stat(self.path).st_ino != self.ino
        except OSError:
            return True

    def close(self):
        if self.file is not None:
            try:
                self.file.close()
            except IOError:
                pass
        self.file = None


def migrate_legacy_log(args, directory=None, serial=None):
    """Fold an old undated cpm.tsv into the dated files, once.

    The original is renamed rather than removed. The split is arithmetic on
    somebody's measurements and it is not worth asking them to trust it on the
    strength of the first run.
    """
    old = os.path.join(directory or state_dir(), LOG_NAME)
    rows = read_log(old)
    if not rows:
        return 0, 0
    header = log_header(args.spans)
    files = {}
    for when, line in rows:
        files.setdefault(log_path(when, directory, serial),
                         []).append((when, line))
    moved = 0
    for path in sorted(files):
        added, _clashed = merge_log(path, header, files[path], args.log_every)
        moved += added
    os.rename(old, old + ".pre-rotation")
    return moved, len(files)


# ---------------------------------------------------------------- backfill ---
#
# THE COUNTER KEPT ITS OWN LOG WHILE NOBODY WAS LISTENING. That is the whole
# point of the flash: it recorded through the hours the machine was off, or the
# counter was in a bag. Reading it back turns those hours into the same rows
# the monitor writes, so one file answers "what was it doing" for the whole
# period rather than only the parts somebody was watching.
#
# The rows are built by replaying the flash samples through the SAME Windows
# and Interval the live logger uses. Not a second implementation of the
# averaging: the same one, fed from a different source. A backfilled row and a
# live row of the same stretch would agree, which is the only way to be sure
# the reconstruction means what the live rows mean.
def rows_from_samples(samples, spans, every, max_gap, src=SRC_FLASH,
                      site_for=None):
    """Replay timed samples into log rows, one per slot, gaps ending averages."""
    rows = []
    w = Windows(spans)
    iv = Interval(spans)
    slot = None
    last = None

    def flush(at):
        if iv.seconds:
            rows.append((at, log_row(at, iv.cps(), iv.counts, iv.seconds,
                                     [w.average(s) for s in w.spans],
                                     iv.peaks, src,
                                     site_for(at) if site_for else "")))
        iv.reset()

    for when, count, dt in samples:
        # A hole in the recording is not a quiet stretch: the counter was off,
        # or out of reach. Averages must not be carried across one.
        if last is not None and when - last > max_gap:
            flush(slot * every)
            w = Windows(spans)
            slot = None
        here = slot_of(when, every)
        if slot is None:
            slot = here
        elif here != slot:
            flush(slot * every)
            slot = here
        w.add(when, count)
        iv.add(count, [w.average(s) for s in w.spans], dt or 1.0)
        last = when
    if slot is not None:
        flush(slot * every)
    return rows


def backfill(blob, args, offset=0.0, path=None, serial=None):
    """Fold whatever the image can account for into the log. Returns a report."""
    every = args.log_every
    sites = ensure_site(serial) if serial else []

    def site_for(when):
        found = site_at(serial, when, sites) if serial else None
        return found[2] if found else ""

    # SORTED, because an image is not always in time order. A full dump of a
    # wrapped ring has one step backwards in it, and replaying that as it lies
    # would end every average at the seam and file half the week under the
    # wrong slots. read_history_tail hands back chronological bytes and this
    # costs nothing there; it is what makes `backfill --image` of a raw dump
    # give the same answer.
    samples = sorted(history_samples(blob, offset))
    if not samples:
        return {"samples": 0, "rows": 0, "added": 0, "clashed": 0,
                "first": None, "last": None, "holes": 0, "files": []}
    rows = rows_from_samples(samples, args.spans, every, args.max_gap,
                             site_for=site_for)
    header = log_header(args.spans)
    if path:
        files = {path: rows}
    else:
        files = {}
        for r in rows:
            files.setdefault(log_path(r[0], serial=serial), []).append(r)
    added = clashed = 0
    for one in sorted(files):
        a, c = merge_log(one, header, files[one], every)
        added += a
        clashed += c
    # Holes are worth counting and saying out loud. They are the hours the
    # counter was off or out of reach, they are not filled, and a person
    # looking at a suspiciously short file deserves to know there were 42 of
    # them rather than wondering what the backfill lost.
    holes = sum(1 for a, b in zip(rows, rows[1:]) if b[0] - a[0] > every)
    return {"samples": len(samples), "rows": len(rows), "added": added,
            "clashed": clashed, "first": samples[0][0], "last": samples[-1][0],
            "holes": holes, "files": sorted(files)}


def read_history_tail(counter, want, quiet=False):
    """The newest `want` bytes of the flash, in the order they were recorded.

    In a wrapped ring the newest bytes end at the write pointer and, if more
    are asked for than lie before it, continue from the physical end of the
    chip. What comes back is always chronological, so nothing downstream has
    to know the flash is a circle.
    """
    size = counter.flash_size or 0
    if not size:
        return b""
    end, wrapped = find_history_end(counter, size)
    if end <= 0:
        return b""

    def grab(address, length):
        got = b""
        while len(got) < length:
            chunk = counter.read_history(address + len(got),
                                         min(SPIR_CHUNK * 8, length - len(got)))
            if not chunk:
                break
            got += chunk
        return got

    if not quiet:
        print("radbeeper: newest history at %d KiB of %d KiB%s; reading %d KiB"
              % (end // 1024, size // 1024,
                 " (wrapped)" if wrapped else "", min(want, size) // 1024))
    if want <= end:
        return grab(end - want, want)
    head = grab(0, end)
    if not wrapped:
        return head
    over = min(want - end, size - end)
    return grab(size - over, over) + head


def say_backfill(report, offset):
    if not report["samples"]:
        print("radbeeper: no placeable samples in the history read")
        return
    span = "%s .. %s" % (
        time.strftime("%Y-%m-%d %H:%M", time.localtime(report["first"])),
        time.strftime("%Y-%m-%d %H:%M", time.localtime(report["last"])))
    print("radbeeper: %d samples, %s" % (report["samples"], span))
    if offset:
        print("           counter clock corrected by %+.0f s" % offset)
    print("           %d rows: %d added, %d already logged live"
          % (report["rows"], report["added"], report["clashed"]))
    if report["holes"]:
        print("           %d gaps left as gaps -- the counter was not recording"
              % report["holes"])
    for one in report["files"]:
        print("           -> %s" % one)


def cmd_backfill(args):
    if not args.log:
        try:
            moved, files = migrate_legacy_log(args, serial=args.serial)
            if moved:
                print("radbeeper: %d rows from %s split across %d dated log%s"
                      % (moved, LOG_NAME, files, "" if files == 1 else "s"))
        except OSError as e:
            print("radbeeper: could not split %s -- %s" % (LOG_NAME, e))
    if args.image:
        with open(args.image, "rb") as f:
            blob = f.read()
        if not args.serial:
            print("radbeeper: --serial is how a dumped image says which "
                  "counter it came from", file=sys.stderr)
            return 1
        offset = args.clock_offset or 0.0
        report = backfill(blob, args, offset, args.log, args.serial)
        say_backfill(report, offset)
        return 0
    try:
        counter = open_counter(args)
    except NotFound as e:
        print("%s: %s" % ("port busy" if e.busy else "no counter", e.reason),
              file=sys.stderr)
        return 1
    try:
        serial = args.serial or counter.serial_no
        offset = args.clock_offset
        if offset is None:
            offset = measure_clock_offset(counter) or 0.0
        blob = read_history_tail(counter, args.backfill_bytes)
    finally:
        counter.close()
    if not blob:
        print("radbeeper: the counter's history is empty")
        return 0
    report = backfill(blob, args, offset, args.log, serial)
    say_backfill(report, offset)
    return 0


def cmd_site(args):
    """Where a counter is, and everywhere it has been."""
    serial = args.serial
    if not serial:
        try:
            counter = open_counter(args)
            serial = counter.serial_no
            counter.close()
        except NotFound as e:
            print("no counter: %s -- name one with --serial" % e.reason,
                  file=sys.stderr)
            return 1
    if args.name:
        path = record_site(serial, args.name)
        print("%s moved to %s" % (serial, args.name))
        print("  recorded in %s" % path)
        return 0
    sites = ensure_site(serial)
    mine = [r for r in sites if r[0] == serial]
    now = site_at(serial, time.time(), sites)
    print("counter %s" % serial)
    print("now     %s" % now[2])
    if len(mine) > 1:
        print("history")
        for _s, when, name in mine:
            print("  %s  %s"
                  % ("from the start  " if when <= 0 else
                     time.strftime("%Y-%m-%d %H:%M", time.localtime(when)),
                     name))
    return 0


# ------------------------------------------------------------------ export ---
#
# WHY THIS IS IN HERE AND NOT A SEPARATE SCRIPT. The point of the export is
# that somebody can fork the repository, drop their own logs in, and have a
# page. A separate script is a second thing to install, a second thing to keep
# in step with the row format, and the first thing to rot when a column is
# added. It reads the same files the same way the rest of the program writes
# them, so a format change breaks it here rather than silently on somebody
# else's web page.
#
# The generator is stdlib. The PAGE pulls DataTables from a CDN, which is a
# different question from what this program depends on: a browser fetching a
# table widget is not a Pi Zero fetching a package.
LOG_GLOB = "cpm-"


def log_files(directory=None):
    """[(serial, path)] for every dated log in a directory, oldest name first."""
    d = directory or state_dir()
    out = []
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return out
    for name in names:
        if not name.startswith(LOG_GLOB) or not name.endswith(".tsv"):
            continue
        stem = name[len(LOG_GLOB):-len(".tsv")]
        # cpm-<serial>-YYYY-MM.tsv, and a serial may contain no dash we care
        # about: split from the right, where the date is.
        bits = stem.rsplit("-", 2)
        if len(bits) != 3:
            continue
        out.append((bits[0], os.path.join(d, name)))
    return out


def read_rows(path):
    """Yield (when, cells) for a dated log, header and blanks skipped."""
    try:
        with open(path) as f:
            for line in f:
                line = line.rstrip("\n")
                when = row_time(line)
                if when is not None:
                    yield when, line.split("\t")
    except IOError:
        return


def summarise(directory=None, cpm_per_usvh=DEFAULT_CPM_PER_USVH):
    """Per counter: the totals, the daily rollup, and the last rows seen.

    The daily rollup is counts over seconds, not a mean of the per-row CPMs:
    rows are not all the same length -- a service stopped mid-interval writes a
    short one -- and averaging averages would weight a four-second row like a
    thirty-second one.
    """
    counters = {}
    for serial, path in log_files(directory):
        c = counters.setdefault(serial, {
            "serial": serial, "rows": 0, "counts": 0, "seconds": 0.0,
            "first": None, "last": None, "peak": None, "days": {},
            "latest": [], "sites": set()})
        for when, cells in read_rows(path):
            try:
                counts = int(cells[2])
                seconds = float(cells[3])
            except (IndexError, ValueError):
                continue
            peak = None
            if len(cells) > 7 and cells[7]:
                try:
                    peak = float(cells[7])
                except ValueError:
                    peak = None
            c["rows"] += 1
            c["counts"] += counts
            c["seconds"] += seconds
            c["first"] = when if c["first"] is None else min(c["first"], when)
            c["last"] = when if c["last"] is None else max(c["last"], when)
            if peak is not None and (c["peak"] is None or peak > c["peak"]):
                c["peak"] = peak
            if len(cells) > 11 and cells[11]:
                c["sites"].add(cells[11])
            day = time.strftime("%Y-%m-%d", time.localtime(when))
            d = c["days"].setdefault(day, {"rows": 0, "counts": 0,
                                           "seconds": 0.0, "peak": None})
            d["rows"] += 1
            d["counts"] += counts
            d["seconds"] += seconds
            if peak is not None and (d["peak"] is None or peak > d["peak"]):
                d["peak"] = peak
            c["latest"].append((when, cells))
    for c in counters.values():
        c["latest"].sort(key=lambda r: r[0])
        c["latest"] = c["latest"][-300:]
        c["cpm"] = (c["counts"] * 60.0 / c["seconds"]) if c["seconds"] else 0.0
        c["usvh"] = c["cpm"] / cpm_per_usvh if cpm_per_usvh else 0.0
    return counters


def esc(text):
    return (str(text).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


