# ---------------------------------------------------------------- protocol ---
#
# GQ's RFC for the GMC series. Every command is <NAME>> in ASCII and the reply
# is a fixed number of raw bytes with no framing, so the only way to stay in
# step is to ask for exactly what you expect and time out rather than block.
#
#   <GETVER>>       14 bytes  e.g. "GMC-320Re 4.26"
#   <GETSERIAL>>     7 bytes  BCD
#   <GETCPM>>        2 bytes  big-endian, the device's own 60-second count
#   <GETCPS>>        2 bytes  big-endian, mask 0x3FFF (top bits are flags)
#   <HEARTBEAT1>>    -        then 2 bytes every second, same masking as CPS
#   <HEARTBEAT0>>    -        stop the stream
#   <GETVOLT>>       1 byte   battery, tenths of a volt
#   <GETDATETIME>>   7 bytes  YY MM DD HH MM SS 0xAA
#   <SPIR[aaa][ll]>> ll bytes history flash, 3-byte address, 2-byte length
#
# The heartbeat is the one that matters here: it is the only way to get a
# per-second number out of the device without polling it faster than it
# updates.
CMD_VERSION = b"<GETVER>>"
CMD_SERIAL = b"<GETSERIAL>>"
CMD_CPM = b"<GETCPM>>"
CMD_CPS = b"<GETCPS>>"
CMD_VOLT = b"<GETVOLT>>"
CMD_DATETIME = b"<GETDATETIME>>"
CMD_HEARTBEAT_ON = b"<HEARTBEAT1>>"
CMD_HEARTBEAT_OFF = b"<HEARTBEAT0>>"

# The counter's own reading is masked: the top two bits of the 16-bit CPS and
# heartbeat values are status flags on current firmware, not count.
COUNT_MASK = 0x3FFF

# Both rates GQ has shipped. The 320 is 115200; the 300 is 57600. Trying the
# likely one first costs nothing and probing both costs one second.
BAUD_RATES = (115200, 57600)

# Tube conversion. The M4011 in a GMC-320 reads about 151.5 CPM per uSv/h, and
# this number is a property of the TUBE, not the counter -- a 500 with a
# different tube needs a different one, which is why it is a flag and not a
# constant in the maths.
DEFAULT_CPM_PER_USVH = 151.5

# History flash. The 320 carries 1 MiB; the 300 carries 64 KiB. SPIR reads more
# than 4096 bytes at a time unreliably on several firmwares, so the download is
# chunked well under that.
FLASH_SIZES = {"GMC-320": 0x100000, "GMC-300": 0x10000, "GMC-500": 0x100000,
               "GMC-600": 0x100000}
SPIR_CHUNK = 2048

# The accumulating spectrum. 512 samples at one a second resolves periods from
# 2 seconds to 512, in 255 bins -- about two per column of a wide terminal.
#
# RESOLUTION COSTS TIME AND THERE IS NO WAY ROUND IT. You cannot resolve a
# 512-second period in 128 seconds of listening; frequency resolution is 1/T
# for an observation of length T, and that is physics rather than a limitation
# of the code. So a longer window is strictly better in the end and strictly
# slower to say anything, and the first answer here arrives after eight and a
# half minutes. --spectrum-window trades one for the other.
SPECTRUM_WINDOW = 512

# The service log: tab-separated, one row per LOG_EVERY seconds, one file per
# month. LOG_NAME is the single undated file older versions wrote; it is
# migrated into the dated ones the first time it is seen and then kept aside.
LOG_NAME = "cpm.tsv"
DEFAULT_LOG_EVERY = 30.0

# WHERE A ROW CAME FROM, and why the column is worth its width. Rows measured
# live and rows reconstructed from the counter's flash are not the same
# evidence: the live ones were watched by this machine's clock, the flash ones
# were placed by arithmetic over a drifting one. Anybody reading the file a
# month later needs to be able to tell, and a column is the only way that
# survives sort, grep and a spreadsheet.
SRC_LIVE = "live"
SRC_FLASH = "flash"

# How large a hole in the recording ends an average. The counter being off, or
# out of range of anything, leaves a gap; carrying a 300-second window across
# it would average two different afternoons together and call it one number.
DEFAULT_MAX_GAP = 10.0

# WHERE THE COUNTER IS, AND THE FACT THAT IT MOVES. A reading without a place
# is half a measurement -- 40 CPM means one thing in a basement and another on
# a hillside -- and these counters are carried about, so the place is not a
# property of the machine or of the file. It is a property of a SERIAL NUMBER
# OVER TIME, which is what sites.tsv records: append-only, one row per move,
# so a reading from last Tuesday resolves to where the counter was last
# Tuesday and not to where it is now.
#
# A NAME AND NOT A COORDINATE, deliberately. These logs are meant to be
# published -- the export builds a page for a fork to put on the web -- and a
# place name is what a reader needs, while a decimal fix to six places is a
# street address for whoever is holding the counter. Nothing here has any use
# for the precision, so it is not collected.
#
# AND THERE IS NO DEFAULT PLACE. A site is recorded when somebody records one;
# until then the column is empty, which is the truthful answer to "where was
# this taken" and does not put an address on a public page by accident.
SITES_NAME = "sites.tsv"

# How much of the flash tail a backfill reads when it is not told otherwise.
# 64 KiB is around seventeen hours at the interval this counter records, and
# forty seconds of reading -- a whole megabyte is ten minutes, which is not a
# thing to put in front of a service that is trying to start.
DEFAULT_BACKFILL_BYTES = 64 * 1024

# The session watcher, `radbeeper hotplug`. Four seconds is a listdir of /dev
# fifteen times a minute, which costs nothing; --settle is the grace the node
# gets between appearing and being opened, and --tries how many times a plug
# event is worth retrying before it is written off.
DEFAULT_POLL = 4.0
DEFAULT_SETTLE = 2.0
DEFAULT_TRIES = 3

# How long the service waits between attempts on a port that is present but
# locked. See cmd_service for why waiting here is not the retry loop the rest
# of this program refuses to have.
SERVICE_WAIT = 10.0

# Terminal emulators the desktop autostart will open the monitor in, best
# first. foot is the Wayland session's; the rest are what an X11 one is likely
# to have. The list is tried in order and the first that exists wins.
TERMINALS = (("foot", "-e"), ("alacritty", "-e"), ("urxvt", "-e"),
             ("xterm", "-e"), ("st", "-e"))

# Where the boot service leaves things. Under /var/log when it can write there
# and under the home directory when it cannot, because a service that refuses
# to run unprivileged is a service nobody runs.
def state_dir():
    for d in ("/var/log/radbeeper", os.path.expanduser("~/.local/share/radbeeper")):
        try:
            os.makedirs(d, exist_ok=True)
            probe = os.path.join(d, ".writable")
            with open(probe, "w"):
                pass
            os.unlink(probe)
            return d
        except OSError:
            continue
    return "."


# ------------------------------------------------------------------ serial ---
class Busy(Exception):
    """The port is open in another process, and is being left alone."""


class Serial:
    """A raw serial port, in termios rather than in pyserial.

    Non-blocking with an explicit deadline everywhere: a counter that has been
    unplugged mid-read must not wedge the monitor, and select() is the only
    thing standing between this program and a hang with no output.
    """

    def __init__(self, path, baud=115200, timeout=1.0):
        self.path = path
        self.timeout = timeout
        self.fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        # WHY A SERIAL PORT NEEDS A LOCK. Two processes reading one tty do not
        # each get the stream -- they get a share of it each, and neither is
        # told. The logger service and a monitor window both running would
        # quietly halve both their counts, which is a wrong reading that looks
        # entirely plausible: the worst kind there is. flock is advisory, so it
        # costs nothing against programs that do not take it, and every
        # radbeeper takes it -- and radbeepers are exactly the programs that
        # would otherwise collide here.
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(self.fd)
            raise Busy(path)
        try:
            self._configure(baud)
        except Exception:
            os.close(self.fd)
            raise

    def _configure(self, baud):
        speed = getattr(termios, "B%d" % baud, None)
        if speed is None:
            raise ValueError("no termios constant for %d baud" % baud)
        a = termios.tcgetattr(self.fd)
        iflag, oflag, cflag, lflag, ispeed, ospeed, cc = a
        # cfmakeraw, spelled out: 8N1, no flow control, no echo, no line
        # discipline of any kind. The counter speaks bytes, not lines, and a
        # stray ICRNL turns a 0x0D in a count into a 0x0A and silently
        # corrupts every reading that happens to contain one.
        iflag &= ~(termios.IGNBRK | termios.BRKINT | termios.PARMRK
                   | termios.ISTRIP | termios.INLCR | termios.IGNCR
                   | termios.ICRNL | termios.IXON)
        oflag &= ~termios.OPOST
        lflag &= ~(termios.ECHO | termios.ECHONL | termios.ICANON
                   | termios.ISIG | termios.IEXTEN)
        cflag &= ~(termios.CSIZE | termios.PARENB | termios.CSTOPB
                   | termios.CRTSCTS)
        cflag |= termios.CS8 | termios.CREAD | termios.CLOCAL
        cc = list(cc)
        cc[termios.VMIN] = 0
        cc[termios.VTIME] = 0
        termios.tcsetattr(self.fd, termios.TCSANOW,
                          [iflag, oflag, cflag, lflag, speed, speed, cc])
        termios.tcflush(self.fd, termios.TCIOFLUSH)

    def write(self, data):
        total = 0
        while total < len(data):
            try:
                total += os.write(self.fd, data[total:])
            except OSError as e:
                if e.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                    select.select([], [self.fd], [], self.timeout)
                    continue
                raise

    def read(self, count, timeout=None):
        """Exactly count bytes, or fewer if the deadline passes."""
        deadline = time.monotonic() + (self.timeout if timeout is None else timeout)
        out = b""
        while len(out) < count:
            left = deadline - time.monotonic()
            if left <= 0:
                break
            r, _, _ = select.select([self.fd], [], [], left)
            if not r:
                break
            try:
                chunk = os.read(self.fd, count - len(out))
            except OSError as e:
                if e.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                    continue
                raise
            if not chunk:
                break
            out += chunk
        return out

    def flush_input(self):
        termios.tcflush(self.fd, termios.TCIFLUSH)

    def close(self):
        try:
            os.close(self.fd)
        except OSError:
            pass


# ------------------------------------------------------------------ device ---
class Counter:
    """A GQ GMC counter, found and identified."""

    def __init__(self, port, version, serial_no, path, baud):
        self.port = port
        self.version = version
        self.serial_no = serial_no
        self.path = path
        self.baud = baud

    @property
    def model(self):
        # "GMC-320Re 4.26" -> "GMC-320". Everything downstream that cares about
        # the model cares about the family, not the revision.
        head = self.version.split()[0] if self.version else ""
        for known in FLASH_SIZES:
            if head.startswith(known):
                return known
        return head or "unknown"

    @property
    def flash_size(self):
        return FLASH_SIZES.get(self.model, 0x10000)

    def close(self):
        try:
            self.port.write(CMD_HEARTBEAT_OFF)
        except OSError:
            pass
        self.port.close()

    # -- the simple queries ------------------------------------------------
    def _ask(self, cmd, count, timeout=1.0):
        self.port.flush_input()
        self.port.write(cmd)
        return self.port.read(count, timeout)

    def cpm(self):
        b = self._ask(CMD_CPM, 2)
        if len(b) != 2:
            return None
        return struct.unpack(">H", b)[0] & COUNT_MASK

    def cps(self):
        b = self._ask(CMD_CPS, 2)
        if len(b) != 2:
            return None
        return struct.unpack(">H", b)[0] & COUNT_MASK

    def voltage(self):
        b = self._ask(CMD_VOLT, 1)
        if len(b) != 1:
            return None
        return b[0] / 10.0

    def datetime(self):
        b = self._ask(CMD_DATETIME, 7)
        if len(b) != 7:
            return None
        yy, mm, dd, hh, mi, ss = b[0], b[1], b[2], b[3], b[4], b[5]
        try:
            return "20%02d-%02d-%02d %02d:%02d:%02d" % (yy, mm, dd, hh, mi, ss)
        except (TypeError, ValueError):
            return None

    # -- the per-second stream ---------------------------------------------
    def heartbeat(self, on=True):
        self.port.flush_input()
        self.port.write(CMD_HEARTBEAT_ON if on else CMD_HEARTBEAT_OFF)
        if not on:
            # The device may already have queued a sample; drop it so the next
            # command does not read a count where it expects its own reply.
            time.sleep(0.2)
            self.port.flush_input()

    def samples(self):
        """Yield (monotonic_time, counts) once a second, forever.

        The device drives the clock. If it stops talking -- unplugged, asleep,
        cable knocked -- the generator ends rather than blocking, and the
        caller decides whether that is a retry or an exit.
        """
        self.heartbeat(True)
        try:
            while True:
                b = self.port.read(2, timeout=3.0)
                if len(b) != 2:
                    return
                yield time.monotonic(), struct.unpack(">H", b)[0] & COUNT_MASK
        finally:
            try:
                self.heartbeat(False)
            except OSError:
                pass

    # -- the history flash --------------------------------------------------
    def read_history(self, address, length):
        out = b""
        while len(out) < length:
            n = min(SPIR_CHUNK, length - len(out))
            a = address + len(out)
            cmd = b"<SPIR" + bytes([(a >> 16) & 0xFF, (a >> 8) & 0xFF, a & 0xFF,
                                    (n >> 8) & 0xFF, n & 0xFF]) + b">>"
            chunk = self._ask(cmd, n, timeout=5.0)
            if not chunk:
                break
            out += chunk
            if len(chunk) < n:
                break
        return out


class SimCounter:
    """A counter that is not there: a Poisson source at a background rate.

    This exists because the hardware is not always on the desk, and a monitor
    that can only be tested with a radioactive source in hand is a monitor
    nobody tests. Radioactive decay IS a Poisson process, so a Poisson sample
    per second is not a cartoon of the signal -- it has the real variance,
    which is the thing that makes a 3-second average look alarming and a
    300-second one look calm. Testing the display against a smooth fake would
    prove nothing about either.
    """

    def __init__(self, cpm=25.0, seed=None):
        self.rate = cpm / 60.0
        self.random = random.Random(seed)
        self.version = "SIM-000 %s" % VERSION
        self.serial_no = "simulated"
        self.path = "(simulated)"
        self.baud = 0
        self.model = "SIM"
        self.flash_size = 0

    def close(self):
        pass

    def _draw(self):
        # Knuth's method. At background rates L is around 0.4, so this is two
        # or three multiplies and is not worth optimising.
        L = pow(2.718281828459045, -self.rate)
        k, p = 0, 1.0
        while True:
            p *= self.random.random()
            if p <= L:
                return k
            k += 1

    def cpm(self):
        return int(round(self.rate * 60))

    def cps(self):
        return self._draw()

    def voltage(self):
        return 3.9

    def datetime(self):
        return time.strftime("%Y-%m-%d %H:%M:%S")

    def samples(self):
        while True:
            time.sleep(1.0)
            yield time.monotonic(), self._draw()

    def read_history(self, address, length):
        return b"\xff" * length


# --------------------------------------------------------------- discovery ---
#
# WHAT COUNTS AS "THE USB IS PRESENT". Three questions, and they fail in
# different ways, so the answer says which one failed rather than "no device":
#
#   1. Is a serial device node there at all?  If not, either nothing is plugged
#      in or -- the case that cost an afternoon -- the running kernel has no
#      USB-serial driver. Alpine's linux-virt ships none: no ch341, no
#      usbserial, nothing. The counter can be plugged into a VM running it and
#      no ttyUSB will ever appear, and dmesg is silent because the device is
#      never claimed. linux-lts and linux-rpi carry the drivers.
#   2. Can this account open it?  The node is root:dialout, and a user not in
#      that group gets EACCES. That is a fixable mistake, not an absent device.
#   3. Does whatever is on the other end answer <GETVER>>?  A CH340 is a
#      generic cable; plenty of things that are not Geiger counters use one.
SERIAL_GLOBS = ("/dev/ttyUSB", "/dev/ttyACM")


def candidate_ports():
    out = []
    for prefix in SERIAL_GLOBS:
        base, name = os.path.split(prefix)
        try:
            entries = sorted(os.listdir(base))
        except OSError:
            continue
        for e in entries:
            if e.startswith(name):
                out.append(os.path.join(base, e))
    return out


def usb_serial_driver_present():
    """Whether the running kernel could bind a USB serial adapter at all."""
    release = os.uname().release
    root = "/lib/modules/%s" % release
    names = ("usbserial", "ch341", "cp210x", "ftdi_sio", "pl2303", "cdc-acm",
             "cdc_acm")
    # Built in rather than modular is entirely possible, and /proc/config.gz is
    # not on Alpine. A bound driver in sysfs settles it either way.
    if os.path.isdir("/sys/bus/usb-serial/drivers"):
        try:
            if os.listdir("/sys/bus/usb-serial/drivers"):
                return True
        except OSError:
            pass
    for dirpath, _dirnames, filenames in os.walk(root):
        for f in filenames:
            stem = f.split(".")[0]
            if stem in names:
                return True
    return False


def identify(path, baud=None, timeout=1.0):
    """Open a port and ask what it is. None if it is not a GMC."""
    rates = (baud,) if baud else BAUD_RATES
    for rate in rates:
        port = None
        try:
            port = Serial(path, rate, timeout)
            # The device answers a version string; anything else on the line
            # answers with silence or with something that is not GMC-shaped.
            port.flush_input()
            port.write(CMD_VERSION)
            raw = port.read(14, timeout)
            text = raw.decode("ascii", "replace").strip()
            if not text or "GMC" not in text.upper():
                port.close()
                continue
            port.flush_input()
            port.write(CMD_SERIAL)
            sraw = port.read(7, timeout)
            serial_no = sraw.hex().upper() if len(sraw) == 7 else "unknown"
            return Counter(port, text, serial_no, path, rate)
        except OSError:
            if port is not None:
                port.close()
            continue
        except Exception:
            if port is not None:
                port.close()
            raise
    return None


class NotFound(Exception):
    """No counter, with a reason a person can act on."""

    def __init__(self, reason, detail="", busy=False):
        super().__init__(reason)
        self.reason = reason
        self.detail = detail
        # A locked port is not an absent one, and the two want opposite
        # responses: an absent counter means stop, a busy one means wait.
        self.busy = busy


def find_counter(device=None, baud=None, source="auto", sim_cpm=25.0, seed=None):
    if source == "sim":
        return SimCounter(sim_cpm, seed)
    ports = [device] if device else candidate_ports()
    if not ports:
        if not usb_serial_driver_present():
            raise NotFound(
                "no USB-serial driver in this kernel",
                "Running %s. Alpine's linux-virt has no ch341/usbserial at all,\n"
                "so a counter plugged in here can never appear as /dev/ttyUSB0.\n"
                "linux-lts and linux-rpi carry the drivers."
                % os.uname().release)
        raise NotFound("no serial device is present",
                       "Nothing matching /dev/ttyUSB* or /dev/ttyACM*.")
    denied = []
    busy = []
    for p in ports:
        try:
            found = identify(p, baud)
        except Busy:
            busy.append(p)
            continue
        except PermissionError:
            denied.append(p)
            continue
        except OSError as e:
            denied.append("%s (%s)" % (p, e.strerror))
            continue
        if found is not None:
            return found
    if busy:
        raise NotFound(
            "the port is already open by another radbeeper",
            "%s is locked by another process. Nothing is wrong with the\n"
            "counter -- something else is reading it. Usually that is the\n"
            "logger service, which takes the port at boot and whenever one is\n"
            "plugged in:  doas rc-service radbeeper stop  hands it over."
            % ", ".join(busy), busy=True)
    if denied:
        raise NotFound("the serial device cannot be opened by this account",
                       "%s\nAdd yourself to the dialout group: "
                       "doas adduser $USER dialout, then log in again."
                       % ", ".join(denied))
    raise NotFound("a serial device is present but is not a GMC counter",
                   "Tried %s. None answered <GETVER>> with a GMC version."
                   % ", ".join(ports))


# ---------------------------------------------------------------- spectrum ---
#
# WHAT AN FFT OF THIS IS FOR, AND WHY A BORING ANSWER IS THE RIGHT ONE.
# Radioactive decay is a Poisson process, and the power spectrum of a Poisson
# process is FLAT -- white noise, every frequency carrying the same expected
# power. So a healthy counter watching background produces a spectrum with no
# shape in it at all, and that is the useful result: it is a statement that
# nothing periodic is happening.
#
# What it is for is the other case. A peak means something is arriving on a
# schedule, and decay does not have a schedule. Mains hum picked up on the
# tube's high-voltage supply, a fan or a pump passing a source, a loose
# connector chattering, a firmware that batches its reporting -- all of them
# put a line in the spectrum that no amount of staring at a CPM number would
# separate from ordinary noise, because in the time domain they look exactly
# like more counts.
#
# IT ACCUMULATES, which is Bartlett's method and is the whole reason it works.
# One 128-sample periodogram of a Poisson process is not flat -- it is flat in
# expectation and violently noisy in fact, every bin an exponential random
# variable with standard deviation equal to its own mean. Averaging N of them
# divides that scatter by root N, so a real line climbs out of the grass while
# the grass settles down. Ten minutes of watching is five windows; an hour is
# twenty-eight, and by then a peak twice the mean is worth believing.
def fft(values):
    """Iterative radix-2 Cooley-Tukey. Stdlib cmath, for the same reason there
    is no pyserial: 25 lines against a dependency this program cannot assume.
    """
    n = len(values)
    if n == 0 or (n & (n - 1)):
        raise ValueError("fft needs a power-of-two length, got %d" % n)
    a = [complex(v) for v in values]
    # Bit-reversal permutation, in place.
    j = 0
    for i in range(1, n):
        bit = n >> 1
        while j & bit:
            j ^= bit
            bit >>= 1
        j |= bit
        if i < j:
            a[i], a[j] = a[j], a[i]
    size = 2
    while size <= n:
        step = cmath.exp(-2j * cmath.pi / size)
        half = size // 2
        for start in range(0, n, size):
            w = 1 + 0j
            for k in range(start, start + half):
                u = a[k]
                v = a[k + half] * w
                a[k] = u + v
                a[k + half] = u - v
                w *= step
        size <<= 1
    return a


class Spectrum:
    """A running average of periodograms over a fixed window.

    THE MEAN IS REMOVED BEFORE EVERY TRANSFORM. The DC term is the count rate,
    which is what every other number on the screen already says; leaving it in
    would put a mountain at bin zero and flatten everything worth seeing into
    the foothills.

    A HANN TAPER, because a period that does not divide the window exactly
    would otherwise leak its energy across every bin -- turning the one real
    line into a raised floor, which is precisely the shape this is meant to
    tell apart from a raised floor.
    """

    def __init__(self, window=SPECTRUM_WINDOW):
        self.window = window
        self.bins = window // 2
        self.buf = []
        self.power = [0.0] * self.bins
        self.runs = 0
        self.taper = [0.5 - 0.5 * math.cos(2 * math.pi * i / (window - 1))
                      for i in range(window)]

    def add(self, counts):
        """One sample in. True when that closed a window.

        THE MEMORY IS FIXED AND SMALL, whatever the run length. One window of
        samples and one float per bin -- about six kilobytes at the default,
        the same after five minutes as after five weeks. There is nothing to
        keep per elapsed hour: a running sum of periodograms IS the average,
        given the count of them, so the whole history compresses into the
        numbers already there.

        HALF-OVERLAPPED WINDOWS, which is Welch's method rather than
        Bartlett's. Dropping only half the buffer and transforming again gets
        two averages out of every window's worth of data instead of one, so
        the noise settles about 1.4 times faster for the same waiting. The
        segments share half their samples so they are not quite independent --
        the scatter falls as though there were 9/11 as many, which is what
        `independent` below reports and what the significance is judged on.
        """
        self.buf.append(float(counts))
        if len(self.buf) < self.window:
            return False
        mean = sum(self.buf) / self.window
        shaped = [(v - mean) * t for v, t in zip(self.buf, self.taper)]
        spec = fft(shaped)
        for i in range(self.bins):
            self.power[i] += abs(spec[i]) ** 2
        self.runs += 1
        del self.buf[:self.window // 2]
        return True

    def independent(self):
        """Effective number of independent averages, for the overlap."""
        return self.runs * 9.0 / 11.0 if self.runs > 1 else self.runs

    def sigma(self, rel):
        """How many standard deviations above flat a relative power is.

        NO EXTRA STATE IS NEEDED FOR THIS, which is the pleasant part. Each
        bin of one periodogram of white noise is exponentially distributed --
        its standard deviation equals its own mean -- so the average of N has
        a relative scatter of exactly 1/sqrt(N). The threshold is arithmetic
        on the number of windows, not a variance accumulated alongside.

        It is NOT on its own a reason to believe anything: see chance_max.
        """
        n = self.independent()
        if n < 1:
            return 0.0
        return (rel - 1.0) * math.sqrt(n)

    def chance_max(self):
        """How tall the tallest bin gets on a quiet counter, by luck alone.

        THE TRAP THIS EXISTS TO AVOID. Sigma is computed from one bin, but the
        eye picks the tallest of a hundred and twenty-seven of them, and the
        biggest of many draws is much larger than any single draw. Averaged N
        times, a white bin exceeds r by about exp(-N(r-1)); across B bins the
        largest lands near 1 + ln(B)/N. With two windows and 127 bins that is
        nearly 4x -- so a bin at 4.9x, which reads as a confident five sigma,
        is very close to what an entirely healthy counter produces every time
        somebody looks. With twenty-eight windows the same arithmetic gives
        1.2x, and 4.9x is then overwhelming.

        Reporting the first as a detection is the same mistake as drawing a
        three-second average as though it were settled, one panel up.
        """
        n = self.independent()
        if n < 1 or self.bins < 2:
            return float("inf")
        return 1.0 + math.log(self.bins - 1) / n

    def wait(self):
        """Samples still needed before the first window closes."""
        return 0 if self.runs else self.window - len(self.buf)

    def loudest(self):
        """(relative power, bin index) of the biggest bin, or (0, 0)."""
        rel = self.relative()
        if not rel:
            return 0.0, 0
        top = max(rel)
        return top, rel.index(top)

    def averaged(self):
        """Mean power per bin, DC dropped. Empty until a window has closed."""
        if not self.runs:
            return []
        return [p / self.runs for p in self.power[1:]]

    def relative(self):
        """Each bin against the average bin: 1.0 is what flat looks like.

        Poisson is flat, so this is the number that means anything -- an
        absolute power depends on the count rate and says nothing about
        whether the arrivals were random.
        """
        avg = self.averaged()
        if not avg:
            return []
        mean = sum(avg) / len(avg)
        if mean <= 0:
            return [0.0] * len(avg)
        return [p / mean for p in avg]

    def period(self, index, rate=1.0):
        """Seconds per cycle for a bin of the averaged (DC-dropped) spectrum."""
        k = index + 1
        return self.window / (k * rate)


class SpectrumLadder:
    """Several windows at once, so resolution grows with observation time.

    THE TENSION THIS RESOLVES. Frequency resolution is 1/T for an observation
    of length T -- you cannot resolve a 512-second period in 128 seconds of
    listening, and that is physics, not an implementation. So a long window is
    strictly better in the end and strictly slower to say anything at all, and
    picking one means picking which of those to give up.

    Running them side by side gives up neither. The 128-second window answers
    after two minutes; the 512-second one takes eight and a half but resolves
    four times as finely, and by the time it has anything to say it is the
    better answer. The display shows the finest window that has enough
    averages to be worth believing and falls back as far as it must.

    It costs one buffer and one float per bin per rung -- about ten kilobytes
    for the three of them, fixed for the life of the process. Each rung sees
    the same samples; nothing is copied per elapsed hour.
    """

    def __init__(self, windows=(128, 256, 512)):
        self.rungs = [Spectrum(w) for w in sorted(windows)]

    def add(self, counts):
        closed = False
        for rung in self.rungs:
            closed = rung.add(counts) or closed
        return closed

    def best(self, least=2):
        """The finest rung with `least` windows behind it, else the coarsest
        that has any, else the one closest to saying something."""
        for rung in reversed(self.rungs):
            if rung.runs >= least:
                return rung
        for rung in reversed(self.rungs):
            if rung.runs:
                return rung
        return min(self.rungs, key=lambda r: r.wait())


def spectrum_columns(rel, width):
    """Fold the bins onto the columns the screen actually has.

    The window gives 63 bins and a terminal gives whatever it gives, so each
    column is the LOUDEST bin it covers rather than the average of them: a
    single sharp line is the thing being looked for, and averaging it with its
    quiet neighbours is how it disappears.
    """
    if not rel or width < 1:
        return []
    out = []
    n = len(rel)
    for c in range(width):
        lo = c * n // width
        hi = max(lo + 1, (c + 1) * n // width)
        out.append(max(rel[lo:hi]))
    return out


# ----------------------------------------------------------------- entropy ---
#
# RANDOM NUMBERS OUT OF DECAY, AND THE THREE WAYS THAT GOES WRONG.
#
# The physics is sound and old: the moment a nucleus decays is not determined
# by anything, so the arrival times are the textbook hardware entropy source.
# What goes wrong is everything between the tube and the hex.
#
#   1. NOT FROM THE FFT. A transform is linear and invertible -- it moves
#      information about, it does not make any. Worse, the coefficients here
#      come from a mean-subtracted, Hann-tapered window, so neighbouring bins
#      are strongly correlated with each other by construction. Bits pulled
#      out of them would look beautiful and carry far less than they appear
#      to. The entropy is in the counts; the spectrum is a view of the counts.
#
#   2. NOT BY XOR AND ROTATION. Shifting and XOR-ing a block rearranges what
#      is in it. A block holding twenty bits of entropy holds twenty bits
#      after any amount of barrel-shifting, while looking more and more
#      convincing. The standard tool for condensing a lot of weakly-random
#      data into a little strongly-random data is a cryptographic hash, and
#      SHA-256 is in the standard library and is faster than the shifting.
#
#   3. NOT PROVEN BY A FLAT SPECTRUM. Flatness is necessary and nowhere near
#      sufficient: a counter, an LFSR and a square wave at the Nyquist rate
#      all pass it. It is used here as a HEALTH CHECK on the source -- a peak
#      means something periodic is contaminating the arrivals -- and the
#      emission is marked when it fails. It is not the proof of anything.
#
# WHAT IS ACTUALLY DONE. Raw per-second counts go into a pool. Their
# min-entropy is estimated from the observed rate -- for Poisson with mean L,
# no outcome is more likely than the most likely one, so each sample is worth
# -log2(max_k P(k)) bits and that is the honest budget. When the pool holds
# more than the 256 bits being asked for, SHA-256 condenses it and the pool
# starts again. At ordinary background, 40 CPM, that is about one bit a second
# and so about 300 seconds a line -- which is where the cadence comes from
# rather than a number picked to look tidy.
#
# REPRODUCIBLE, WHICH IS NOT THE SAME AS PREDICTABLE. The counts that fed each
# emission are written beside it, so anybody can recompute the line and check
# it. That is an audit trail, not a seed: nothing about it lets you predict
# the NEXT line, because the next line comes from decays that have not
# happened yet.
ENTROPY_BITS = 256          # 64 hex characters
ENTROPY_LABEL = b"radbeeper/entropy/1"


def poisson_min_entropy(rate):
    """Bits per sample for Poisson arrivals at `rate` per sample.

    Min-entropy, not Shannon: the guessing that matters is guessing the most
    likely outcome, so the worth of a sample is -log2 of that probability. It
    is the conservative measure and the one an extractor is entitled to.
    """
    if rate <= 0:
        return 0.0
    # P(k) rises to its peak at k = floor(rate) and falls after; walk to it.
    p = math.exp(-rate)
    best = p
    for k in range(1, int(rate) + 2):
        p *= rate / k
        best = max(best, p)
    if best >= 1.0:
        return 0.0
    return -math.log(best, 2)


def mcv_min_entropy(counts, confidence=2.576):
    """Measured min-entropy per sample, bits. NIST SP 800-90B section 6.3.1.

    WHY NOT THE POISSON FORMULA THIS USED TO USE. Decay is Poisson; the
    per-second counts coming back over the serial link measurably are not.
    Across 1,128 recorded samples from a GMC-320Re the variance is 2.54x the
    mean -- Poisson requires 1.00 -- with 36% too many empty seconds and a
    tail that runs to fourteen times the modelled rate at k=5. Every pool is
    over-dispersed on its own, so it is not a mixture of quiet and busy
    periods, and high seconds fall next to each other about 1.6 times as
    often as independence allows. Ground-level coincidences will do that.

    Over-dispersion concentrates the distribution on its mode, and the mode
    is what min-entropy is about, so the model was claiming 1.15 bits a
    second where the data supports 0.62. This estimator asks the samples
    instead: the frequency of the most common value, pushed to the far end of
    its 99% confidence interval so that the entropy is a LOWER bound rather
    than a point estimate.

    Returns 0.0 until there are enough samples for the bound to say anything,
    which at background is about a dozen seconds.
    """
    n = len(counts)
    if n < 2:
        return 0.0
    most = max(collections.Counter(counts).values())
    p = most / float(n)
    upper = p + confidence * math.sqrt(p * (1.0 - p) / (n - 1))
    if upper >= 1.0:
        return 0.0
    return -math.log(upper, 2)


class Entropy:
    """Random bits from decay timing, with the accounting to justify them."""

    def __init__(self, bits=ENTROPY_BITS):
        self.want = bits
        self.reset()
        self.seq = 0

    def reset(self):
        self.counts = []
        self.started = None
        self.total = 0

    def add(self, when, counts):
        if self.started is None:
            # WALL CLOCK, NOT THE MONOTONIC STAMP THE SAMPLES CARRY. This
            # value goes into the digest and into the emission log, and the
            # samples arrive stamped with time.monotonic() -- seconds since
            # this machine booted. Writing that as an epoch is how every row
            # in the log came to say 1969-12-31, and a reader recomputing a
            # line next month has no way to recover a boot-relative number.
            self.started = time.time()
        self.counts.append(int(counts))
        self.total += int(counts)

    def rate(self):
        return self.total / float(len(self.counts)) if self.counts else 0.0

    def per_sample(self):
        """Measured min-entropy per sample. 0.0 while it cannot yet tell."""
        return mcv_min_entropy(self.counts)

    def bits(self):
        """The pool's min-entropy, in bits, as measured from the samples."""
        return self.per_sample() * len(self.counts)

    def model_bits(self):
        """What the Poisson model would claim, kept only for the comparison.

        Nothing is emitted on the strength of this number. It is reported
        beside the measured one so the gap between them is visible rather
        than argued about.
        """
        return poisson_min_entropy(self.rate()) * len(self.counts)

    def ready(self):
        return self.bits() >= self.want

    def wait(self):
        """Seconds still needed, at the entropy per sample measured so far.

        Deliberately pessimistic: the confidence bound tightens as samples
        arrive, so bits per sample rises slightly and the true wait is a
        little shorter than this says. A countdown that overruns is a worse
        thing to put on a screen than one that finishes early.
        """
        per = self.per_sample()
        if per <= 0:
            return None
        return max(0, int(math.ceil((self.want - self.bits()) / per)))

    def digest(self, seq=None):
        """The line, without consuming the pool. Deterministic in its input."""
        h = hashlib.sha256()
        h.update(ENTROPY_LABEL)
        h.update(b"\x00%d\x00%d\x00" % (seq if seq is not None else self.seq,
                                          int(self.started or 0)))
        h.update(pack_counts(self.counts).encode("ascii"))
        return h.hexdigest()

    def draw(self):
        """Take the line and start collecting again.

        Returns (hex, record) where record is everything needed to recompute
        it: the sequence number, when the pool opened, and the counts.
        """
        seq = self.seq
        out = self.digest(seq)
        record = {"seq": seq, "started": self.started, "seconds":
                  len(self.counts), "bits": self.bits(), "rate": self.rate(),
                  "counts": pack_counts(self.counts), "hex": out}
        self.seq += 1
        self.reset()
        return out, record


def pack_counts(counts):
    """Per-second counts as hex nibbles, 15 meaning "15 or more".

    Compact enough to write beside every emission -- three hundred seconds of
    background is 300 characters -- and lossless over the range that carries
    the entropy. A second with sixteen counts in it is not doing the work here
    and clamping it changes the recomputation for nobody.
    """
    return "".join("%x" % min(15, max(0, int(c))) for c in counts)


def unpack_counts(text):
    return [int(ch, 16) for ch in text]


def pool_bits_modelled(record):
    """What Poisson at the observed rate would have claimed for this pool."""
    return poisson_min_entropy(record["rate"]) * record["seconds"]


def check_entropy_record(record):
    """Recompute a line from the counts recorded beside it."""
    e = Entropy()
    e.started = record["started"]
    e.counts = unpack_counts(record["counts"])
    e.total = sum(e.counts)
    return e.digest(record["seq"]) == record["hex"]


def pool_status(pool, prefix="next in "):
    """Where the pool has got to, in the words each state deserves.

    Three states, and they are not the same thing: nothing has arrived yet,
    something has but not enough of it to measure the source, or the source
    is measured and there is a number of seconds to say.
    """
    left = pool.wait()
    if left is not None:
        return "%s%ds" % (prefix, left)
    if not pool.counts:
        return "no counts yet"
    return "measuring the source (%ds)" % len(pool.counts)


def group_hex(text, size=8, sep=" "):
    """Hex in blocks, because 64 undifferentiated characters cannot be read,
    compared against a screen, or dictated down a phone."""
    return sep.join(text[i:i + size] for i in range(0, len(text), size))


# ---------------------------------------------------------------- averages ---
class Windows:
    """Counts per second in, three running CPM averages out.

    A deque per window would be three copies of the same data. One list of
    (time, counts) covering the longest window serves all three.

    EACH WINDOW KEEPS A RUNNING SUM rather than re-adding its samples. The
    obvious version -- sum the tail on every call -- is O(samples x window),
    which nobody notices at one sample a second and which cost sixteen and a
    half seconds when a backfill pushed 850,000 samples through it: 765
    million additions to produce 28,000 rows. Adding the new sample and
    subtracting the ones that fell out the back is O(1) per window per sample,
    and the same work drops to under a second. The number that made this worth
    doing was measured, not guessed.
    """

    def __init__(self, spans=(3, 30, 300, 3000)):
        self.spans = tuple(spans)
        self.longest = max(self.spans)
        self.samples = []
        self.total = 0
        self.started = None
        # Per span: the running sum, and an absolute index of the oldest
        # sample still inside it. Absolute, because the front of the list is
        # discarded as it ages -- `base` is how many have gone.
        self.sums = [0] * len(self.spans)
        self.heads = [0] * len(self.spans)
        self.base = 0

    def add(self, when, counts):
        if self.started is None:
            self.started = when
        self.samples.append((when, counts))
        self.total += counts
        for i, span in enumerate(self.spans):
            self.sums[i] += counts
            cutoff = when - span
            head = self.heads[i]
            while head - self.base < len(self.samples):
                t, c = self.samples[head - self.base]
                if t > cutoff:
                    break
                self.sums[i] -= c
                head += 1
            self.heads[i] = head
        # Discard what no window can still reach. One sample beyond the
        # longest is kept so a full window is recognisable.
        keep = min(self.heads) - 1
        if keep > self.base:
            del self.samples[:keep - self.base]
            self.base = keep

    def elapsed(self):
        if self.started is None:
            return 0.0
        return self.samples[-1][0] - self.started

    def average(self, span):
        """CPM over the last span seconds, or None until the window is full.

        None is not a failure and must not be drawn as zero: it means "not
        enough signal yet to say", and the difference matters most in the
        first five minutes, which is exactly when someone is watching.
        """
        if not self.samples or self.elapsed() < span:
            return None
        return self.sums[self.spans.index(span)] * 60.0 / span

    def usvh(self, span, cpm_per_usvh):
        cpm = self.average(span)
        if cpm is None or cpm_per_usvh <= 0:
            return None
        return cpm / cpm_per_usvh


class Interval:
    """What happened between two log lines, in constant space.

    The peaks are the reason this class exists. A row written every 30 seconds
    carrying only the averages as they stood at the moment of writing would
    miss a source that came and went in between -- which is the single event
    most worth having in a log afterwards. Keeping a running maximum per window
    costs one comparison a second and no memory that grows, so the interesting
    moment survives without storing the seconds it happened in.

    Nothing here accumulates: counts and seconds are integers, the peaks are
    one float per window, and reset() puts it back to empty. A month of logging
    uses exactly as much memory as the first minute.
    """

    __slots__ = ("spans", "counts", "seconds", "peaks")

    def __init__(self, spans):
        self.spans = tuple(spans)
        self.reset()

    def reset(self):
        self.counts = 0
        self.seconds = 0.0
        self.peaks = [None] * len(self.spans)

    def add(self, counts, averages, dt=1.0):
        """One sample: the raw count, each window as it stands, and how long
        the sample covers.

        dt is 1.0 from the heartbeat, which is a second by definition. It is
        NOT 1.0 when the samples come from the counter's flash, where a
        recorded "second" measures 1.011 of ours -- and a column that says
        `seconds` has to mean seconds, or the cps beside it is a percent wrong
        for no visible reason.
        """
        self.counts += counts
        self.seconds += dt
        for i, cpm in enumerate(averages):
            if cpm is not None and (self.peaks[i] is None or cpm > self.peaks[i]):
                self.peaks[i] = cpm

    def cps(self):
        """Counts per ONE second, whatever the interval's length.

        The interval is 30 seconds by default and the log must not imply that
        the number in this column is 30 seconds' worth: CPS means per second
        here and everywhere else, so the divisor is the elapsed seconds and
        never the row spacing.
        """
        if not self.seconds:
            return 0.0
        return self.counts / float(self.seconds)


# ---------------------------------------------------------------- commands ---
def open_counter(args):
    return find_counter(args.device, args.baud, args.source, args.sim_cpm,
                        args.seed)


def cmd_probe(args):
    try:
        c = open_counter(args)
    except NotFound as e:
        print("%s: %s" % ("port busy" if e.busy else "no counter", e.reason))
        if e.detail:
            for line in e.detail.splitlines():
                print("    %s" % line)
        return 1
    print("counter    %s" % c.version)
    print("model      %s" % c.model)
    print("serial     %s" % c.serial_no)
    print("port       %s @ %s baud" % (c.path, c.baud or "n/a"))
    v = c.voltage()
    if v is not None:
        print("battery    %.1f V" % v)
    d = c.datetime()
    if d:
        print("its clock  %s   (this machine: %s)"
              % (d, time.strftime("%Y-%m-%d %H:%M:%S")))
    n = c.cpm()
    if n is not None:
        print("reading    %d CPM  (%.3f uSv/h at %.1f CPM per uSv/h)"
              % (n, n / args.cpm_per_usvh, args.cpm_per_usvh))
    if c.flash_size:
        print("history    %d KiB of flash" % (c.flash_size // 1024))
    c.close()
    return 0


def cmd_cpm(args):
    try:
        c = open_counter(args)
    except NotFound as e:
        print("no counter: %s" % e.reason, file=sys.stderr)
        return 1
    n = c.cpm()
    c.close()
    if n is None:
        print("the counter did not answer", file=sys.stderr)
        return 1
    print("%d CPM   %.3f uSv/h" % (n, n / args.cpm_per_usvh))
    return 0


def format_line(w, args):
    """One line of the three averages, for a log or a pipe."""
    bits = []
    for span in w.spans:
        v = w.average(span)
        bits.append("%3ds %s" % (span, "  --  " if v is None else "%6.1f" % v))
    return "%s  |  %s  |  total %d in %ds" % (
        time.strftime("%H:%M:%S"), "  ".join(bits), w.total, int(w.elapsed()))


def run_plain(counter, w, args, out=sys.stdout):
    for when, counts in counter.samples():
        w.add(when, counts)
        print(format_line(w, args), file=out, flush=True)
        if args.duration and w.elapsed() >= args.duration:
            return


SPARK = " ▁▂▃▄▅▆▇█"

# How loud a reading is, as a word rather than as a colour.
#
# This lives out here, and not inside the drawing code where it started,
# because a threshold that can only be checked by looking at a screenshot is a
# threshold nobody checks. The bands are deliberately wide: the job of colour
# here is to catch an eye crossing the room, not to grade a dose. Background
# with an M4011 at sea level is roughly 10-50 CPM.
LEVEL_RAISED = 100.0
LEVEL_HIGH = 300.0


def level(cpm):
    if cpm is None:
        return "unknown"
    if cpm >= LEVEL_HIGH:
        return "high"
    if cpm >= LEVEL_RAISED:
        return "raised"
    return "calm"


def sparkline(samples, width):
    tail = samples[-width:]
    if not tail:
        return ""
    peak = max(c for _t, c in tail) or 1
    return "".join(SPARK[min(len(SPARK) - 1, int(c * (len(SPARK) - 1) / peak))]
                   for _t, c in tail)


# A twelve-row digit, six columns wide. Seven-segment shapes with the three
# horizontal bars -- top, middle, bottom -- drawn TWO rows thick, because a
