LEVEL_RAISED = 100.0
LEVEL_HIGH = 300.0


# PORT: replaced by src/analysis.rs :: level() -- same name, same LEVEL_RAISED/LEVEL_HIGH thresholds
def level(cpm):
    if cpm is None:
        return "unknown"
    if cpm >= LEVEL_HIGH:
        return "high"
    if cpm >= LEVEL_RAISED:
        return "raised"
    return "calm"


# PORT: SUPERSEDED. The Rust monitor draws analysis.rs :: bar_rows() instead; analysis.rs :: SPARK still carries the glyph table.
def sparkline(samples, width):
    tail = samples[-width:]
