# --------------------------------------------------------------- the log ---
#
# ONE ROW PER SLOT, AND THE SLOT IS THE KEY. Rows arrive from two places --
# the live monitor, and a backfill reading the counter's flash -- and they must
# not be able to describe the same stretch of time twice. So a row is not
# identified by its timestamp, which is whatever instant the writer happened to
# reach, but by the SLOT it falls in: the log interval it belongs to, floor of
# the time over the row spacing. Two rows clash if and only if they share a
# slot, and a backfill never writes into a slot that already has a row.
#
# GAPS ARE ALLOWED AND ARE NOT FILLED. A slot with no evidence stays absent
# from the file. Nothing is interpolated across it, because a row that says
# 0.000 CPS for a half hour nobody measured is worse than no row at all -- it
# is the same mistake as drawing an unfilled window as zero, one file down.
# PORT: replaced by src/log.rs :: header() -- same columns, same %g formatting via log.rs :: g()
def log_header(spans):
    head = ["time", "cps", "counts", "seconds"]
    head += ["cpm_%g" % s for s in spans]
    head += ["peak_%g" % s for s in spans]
    head.append("src")
    # The place, resolved at the row's own time: a counter that moved
    # mid-month leaves a file whose rows are not all from one site, and a row
    # that cannot say where it was is half a measurement.
    head.append("site")
    # The '#' keeps the header sorting above the rows rather than into the
    # middle of them, so `sort` stays usable on the file as it is, and
    # `grep -v '^#'` drops it when it is in the way.
    return "#" + "\t".join(head)


# PORT: replaced by src/log.rs :: row() -- same tabs, same field order
def log_row(when, cps, counts, seconds, averages, peaks, src, site=""):
    """One tab-separated line: when, how fast, the worst it got, and whence.

    The timestamp is first and is written big-endian, so it sorts
    lexicographically: `sort cpm.tsv` is chronological with no flags, no field
    numbers and no awk, which is the whole reason for that shape.
    """
    cells = [time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(when)),
             "%.3f" % cps, "%d" % counts, "%g" % seconds]
    cells += ["" if a is None else "%.1f" % a for a in averages]
    cells += ["" if p is None else "%.1f" % p for p in peaks]
    cells.append(src)
    cells.append(site or "")
    return "\t".join(cells)


# PORT: replaced by src/log.rs :: read_sites() -- same name
def read_sites(directory=None):
    """[(serial, from_time, name, lat, lon, elevation)], oldest first.

    The last three are None on a row written before fixes were recorded, and
    on any row that simply has not got one. A file with three columns and a
    file with six are both valid and both read; the extra columns are read
    when they are there and never required, because sites.tsv is append-only
    and old rows are not rewritten.
    """
    path = os.path.join(directory or state_dir(), SITES_NAME)
    out = []
    try:
        with open(path) as f:
            for line in f:
                line = line.rstrip("\n")
                if not line.strip() or line.startswith("#"):
                    continue
                cells = line.split("\t")
                if len(cells) < 3:
                    continue
                when = row_time(cells[1] + "\t")
                if when is None:
                    continue
                out.append((cells[0], when, cells[2],
                            _fix_cell(cells, 3), _fix_cell(cells, 4),
                            _fix_cell(cells, 5)))
    except IOError:
        pass
    out.sort(key=lambda r: (r[0], r[1]))
    return out


def _fix_cell(cells, i):
    """A float from an optional column, or None. Junk reads as absent."""
    if i >= len(cells) or cells[i].strip() in ("", "--"):
        return None
    try:
        return float(cells[i])
    except ValueError:
        return None


def parse_fix(text, precision=DEFAULT_FIX_PRECISION):
    """"LAT,LON" -> (lat, lon), rounded to `precision` places.

    ROUNDED HERE, ON THE WAY IN. The rounding is not a display choice that a
    later reader could undo -- the finer digits are discarded before anything
    is written down, so the file cannot be made to give up a precision it was
    never told.
    """
    parts = [p.strip() for p in str(text).replace(";", ",").split(",")]
    if len(parts) != 2:
        raise ValueError("a fix is LAT,LON -- got %r" % (text,))
    try:
        lat, lon = float(parts[0]), float(parts[1])
    except ValueError:
        raise ValueError("a fix is two decimal numbers -- got %r" % (text,))
    if not -90.0 <= lat <= 90.0:
        raise ValueError("latitude out of range: %s" % parts[0])
    if not -180.0 <= lon <= 180.0:
        raise ValueError("longitude out of range: %s" % parts[1])
    return (round(lat, precision), round(lon, precision))


# PORT: replaced by src/log.rs :: site_at() -- same name, same as-of lookup
def site_at(serial, when, sites):
    """Where that counter was at that moment.

    Readings older than the first thing written down belong to the first place
    we know about, not to nowhere: the counter was somewhere, and the earliest
    record is the best evidence of where. Everything after a move belongs to
    the place it moved to.
    """
    mine = [r for r in sites if r[0] == serial]
    if not mine:
        return None
    current = mine[0]
    for row in mine:
        if row[1] <= when:
            current = row
    return current


def fix_text(row, places=None):
    """A site row's coordinates as text, or "" when it has none.

    PRINTED AS STORED, never padded to a fixed width. A fix recorded at one
    decimal place is 51.3, and writing it as 51.300 would assert two digits of
    precision that were deliberately thrown away when it was written down --
    which is the one thing this whole arrangement exists to prevent. The
    file's precision IS the claim.
    """
    del places  # kept for callers; the stored value decides, not the caller
    if not row or len(row) < 5 or row[3] is None or row[4] is None:
        return ""
    out = "%s, %s" % (exact(row[3]), exact(row[4]))
    if len(row) > 5 and row[5] is not None:
        out += " (%gm)" % row[5]
    return out


