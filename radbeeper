# PORT: replaced by src/main.rs :: main() -- same commands, same exit codes
def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 0
    for missing, default in (("log_action", "info"), ("output", None),
                             ("bytes", None), ("poll", DEFAULT_POLL),
                             ("settle", DEFAULT_SETTLE),
                             ("tries", DEFAULT_TRIES), ("backfill", True),
                             ("image", None), ("log", None),
                             ("serial", None), ("name", None),
                             ("logs", None), ("title", "Radiation monitor")):
        if not hasattr(args, missing):
            setattr(args, missing, default)
    handlers = {"probe": cmd_probe, "cpm": cmd_cpm, "watch": cmd_watch,
                "log": cmd_log, "service": cmd_service, "window": cmd_window,
                "hotplug": cmd_hotplug, "backfill": cmd_backfill,
                "site": cmd_site, "export": cmd_export,
                "random": cmd_random, "recompute": cmd_recompute}
    try:
        return handlers[args.command](args)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
