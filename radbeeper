#
# WHERE THE BITS COME FROM, AND WHAT THE LINK COSTS. The heartbeat gives two
# bytes per device-second and nothing finer, so one sample is one integer:
# how many arrivals landed in that second. That single fact sets the whole
# budget, and it is the reason the page below spends as much space on the
# sampling resolution as on the arithmetic.
RANDOM_GLOB = "random-"


def random_files(directory=None):
    """[(serial, path)] for every emission log in a directory."""
    d = directory or state_dir()
    out = []
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return out
    for name in names:
        if not name.startswith(RANDOM_GLOB) or not name.endswith(".tsv"):
            continue
        serial = name[len(RANDOM_GLOB):-len(".tsv")]
        out.append((serial, os.path.join(d, name)))
    return out


def read_random(path):
    """Emissions, oldest first, each with the counts that produced it."""
    rows = []
    try:
        f = open(path)
    except OSError:
        return rows
    with f:
        for line in f:
            if line.startswith("#") or not line.strip():
                continue
            c = line.rstrip("\n").split("\t")
            if len(c) < 8:
                continue
            try:
                rows.append({
                    "seq": int(c[0]), "time": c[1], "seconds": int(c[2]),
                    "rate": float(c[3]), "bits": float(c[4]),
                    "flat": c[5] == "yes", "hex": c[6],
                    "counts": unpack_counts(c[7]),
                })
            except ValueError:
                continue
    return rows


def entropy_budget(samples):
    """Everything the page says about a set of per-second counts.

    Measured first, modelled second, and the ratio between them, because the
    gap is the whole point: the model was the thing that used to be believed.
    """
    n = len(samples)
    if n < 2:
        return None
    freq = collections.Counter(samples)
    mean = sum(samples) / float(n)
    var = sum((x - mean) ** 2 for x in samples) / (n - 1) if n > 1 else 0.0
    most = max(freq.values())
    measured = mcv_min_entropy(samples)
    modelled = poisson_min_entropy(mean)
    return {
        "n": n, "mean": mean, "var": var,
        "dispersion": (var / mean) if mean else 0.0,
        "pmax": most / float(n),
        "measured": measured, "modelled": modelled,
        "ratio": (modelled / measured) if measured else 0.0,
        "freq": freq,
        "seconds_for": (ENTROPY_BITS / measured) if measured else None,
        "seconds_modelled": (ENTROPY_BITS / modelled) if modelled else None,
    }


def poisson_pmf(lam, k):
    return math.exp(-lam) * lam ** k / math.factorial(k)


def svg_hist(freq, lam, width=1120, height=340, pad_l=54, pad_b=34, pad_t=14,
             pad_r=12):
    """Observed counts against the Poisson the model assumed, side by side.

    A log y axis, because the interesting disagreement is in the tail: at
    k=5 the observed bar is fourteen times the modelled one and on a linear
    axis both are invisible.
    """
    n = sum(freq.values())
    if not n:
        return ""
    kmax = max(max(freq), 8)
    kmax = min(kmax, 12)
    obs = [(freq.get(k, 0) / float(n)) for k in range(kmax + 1)]
    exp = [poisson_pmf(lam, k) for k in range(kmax + 1)]
    floor = 1e-5
    lo, hi = floor, 1.0
    span = math.log10(hi) - math.log10(lo)
    iw = width - pad_l - pad_r
    ih = height - pad_t - pad_b
    slot = iw / float(kmax + 1)
    bw = slot * 0.36

    def Y(p):
        return pad_t + ih * (1.0 - (math.log10(max(p, lo)) - math.log10(lo))
                             / span)

    out = ['<svg class="plot hist" viewBox="0 0 %d %d" width="100%%" '
           'preserveAspectRatio="xMidYMid meet" role="img" aria-label="'
           'observed counts per second against the Poisson model">'
           % (width, height)]
    for decade in (1.0, 0.1, 0.01, 0.001, 0.0001, 0.00001):
        y = Y(decade)
        out.append('<line class="grid" x1="%d" y1="%.1f" x2="%d" y2="%.1f"/>'
                   % (pad_l, y, width - pad_r, y))
        out.append('<text class="ylab" x="%d" y="%.1f">%s</text>'
                   % (pad_l - 8, y + 4,
                      ("%g" % decade) if decade >= 0.001 else "%.0e" % decade))
    base = Y(floor)
    for k in range(kmax + 1):
        x = pad_l + slot * k + slot / 2
        for i, (p, cls) in enumerate(((exp[k], "modelled"), (obs[k], "seen"))):
            if p <= 0:
                continue
            y = Y(p)
            out.append('<rect class="%s" x="%.1f" y="%.1f" width="%.1f" '
                       'height="%.1f"/>'
                       % (cls, x + (i - 1) * bw, y, bw, max(0.0, base - y)))
        out.append('<text class="xlab" x="%.1f" y="%d">%d</text>'
                   % (x, height - 12, k))
    out.append('<text class="xcap" x="%d" y="%d">counts in one second</text>'
               % (pad_l, height - 1))
    out.append('<text class="ycap" x="%d" y="%d">share of seconds</text>'
               % (pad_l - 46, pad_t - 2))
    out.append("</svg>")
    return "".join(out)


def svg_bits(samples, want=ENTROPY_BITS, width=1120, height=320, pad_l=54,
             pad_b=34, pad_t=14, pad_r=12):
    """Bits accumulating against seconds: measured, and what was claimed.

    The measured line starts flat -- the confidence bound says nothing until
    there are a dozen or so samples -- then straightens as the estimate
    settles. Where it crosses the target is when a line is emitted.
    """
    n = len(samples)
    if n < 30:
        return ""
    step = max(1, n // 240)
    xs, meas, model = [], [], []
    pool = Entropy(want)
    for i, x in enumerate(samples, 1):
        pool.add(0.0, x)
        if i % step and i != n:
            continue
        xs.append(i)
        meas.append(pool.bits())
        model.append(poisson_min_entropy(pool.rate()) * i)
    hi = max(max(model), want) * 1.05
    iw = width - pad_l - pad_r
    ih = height - pad_t - pad_b
    X = lambda t: pad_l + iw * t / float(n)
    Y = lambda v: pad_t + ih * (1.0 - v / hi)

    def path(ys):
        return " ".join(("M" if i == 0 else "L") + "%.1f %.1f" % (X(x), Y(y))
                        for i, (x, y) in enumerate(zip(xs, ys)))

    out = ['<svg class="plot bits" viewBox="0 0 %d %d" width="100%%" '
           'preserveAspectRatio="xMidYMid meet" role="img" aria-label="'
           'bits of min-entropy accumulating against seconds">'
           % (width, height)]
    # A gridline every 64 bits is twenty-one labels on a long pool. Pick the
    # coarsest step that still leaves five or more.
    tick = next((t for t in (64, 128, 256, 512, 1024) if hi / t <= 8), 1024)
    v = 0
    while v <= hi:
        y = Y(v)
        out.append('<line class="grid" x1="%d" y1="%.1f" x2="%d" y2="%.1f"/>'
                   % (pad_l, y, width - pad_r, y))
        out.append('<text class="ylab" x="%d" y="%.1f">%d</text>'
                   % (pad_l - 8, y + 4, v))
        v += tick
    out.append('<line class="target" x1="%d" y1="%.1f" x2="%d" y2="%.1f"/>'
               % (pad_l, Y(want), width - pad_r, Y(want)))
    for t in range(0, n + 1, max(60, (n // 8 // 60 or 1) * 60)):
        if t == 0:
            continue
        out.append('<text class="xlab" x="%.1f" y="%d">%ds</text>'
                   % (X(t), height - 12, t))
    out.append('<path class="peak" d="%s"/>' % path(model))
    out.append('<path class="mean" d="%s"/>' % path(meas))
    out.append('<text class="ycap" x="%d" y="%d">bits</text>'
               % (pad_l - 46, pad_t - 2))
    out.append("</svg>")
    return "".join(out)


