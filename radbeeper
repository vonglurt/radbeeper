    for serial, path in log_files(directory):
        if serial in counters:
            counters[serial].setdefault("links", []).append(
                (os.path.basename(path), os.path.relpath(path, out_dir)))
    sites = read_sites(directory)
    # Screenshots are linked only when they are actually beside the page, so
    # an export into some other directory does not litter it with broken
    # images.
    shots = {}
    for name in ("probe", "watch", "watch-filling", "watch-spectrum",
                 "watch-plain", "log-output", "log-tabs", "commands",
                 "watch-20s"):
        ext = ".gif" if name == "watch-20s" else ".png"
        rel = os.path.join("docs", "screenshots", name + ext)
        if os.path.exists(os.path.join(out_dir, rel)):
            shots[name] = rel.replace(os.sep, "/")
    out = args.output or "index.html"
    # The audit page, when there is anything to audit. Written first so the
    # front page only links to it if it exists.
    randoms = []
    for serial, path in random_files(directory):
        pools = read_random(path)
        if pools:
            randoms.append((serial, pools))
    # ONE AUDIT PAGE PER COUNTER, NOT ONE PER MACHINE. This used to write the
    # first counter's emissions and silently drop every other tube's: with two
    # counters plugged in, half the record simply had no page and nothing said
    # so. An emission is an audit trail of ONE source and is recomputed from
    # that source's own counts, so it cannot be merged with another's either.
    #
    # The first keeps the name `random.html` -- or whatever --random-output
    # asked for -- so a page that has always been at that address still is.
    # The rest go beside it as `random-<serial>.html`.
    random_pages = []
    if not args.no_random_page:
        every = [s for s, _ in randoms]
        budget = getattr(args, "frame_budget", None)
        if budget is None:
            budget = DEFAULT_FRAME_BUDGET
        for i, (serial, pools) in enumerate(randoms):
            if i == 0:
                target = args.random_output or os.path.join(
                    out_dir, "random.html")
            else:
                target = os.path.join(out_dir, "random-%s.html" % serial)
            # The place as it was at the LAST emission, not as it is now: the
            # page describes a stretch of recording, and wherever the counter
            # has been moved to since is not where those counts were taken.
            last = row_time(pools[-1]["time"] + "\t")
            here = site_at(serial, export_now() if last is None else last,
                           sites)
            joined = join_emissions(directory, serial, pools,
                                    args.cpm_per_usvh)
            head = ["radbeeper %s -- counter %s" % (VERSION, serial),
                    "emissions %d" % len(pools)]
            if here:
                head.append("place %s" % here[2])
                fix = fix_text(here)
                if fix:
                    head.append("fix %s" % fix)
            head.append("counts is clamped at fifteen a second, as the "
                        "emission log records it; the .bin frames hold it "
                        "unclamped")
            tsv = joined_tsv(joined, head)
            # The table goes out as a file as well as into the page, because
            # a table somebody can only read through javascript is a table
            # they cannot check with anything else.
            with open(os.path.join(out_dir, "frames-%s.tsv" % serial),
                      "w") as f:
                f.write(tsv)
            embed = frames_to_embed(directory, serial, budget)
            audit = {
                "place": here[2] if here else "",
                "fix": fix_text(here) if here else "",
                "joined": tsv,
                "frames": base64.encodebytes(
                    frames_bytes(embed)).decode("ascii"),
                "embedded": [os.path.basename(x) for x in embed],
                "files": audit_downloads(directory, serial),
                "siblings": [x for x in every if x != serial],
            }
            with open(target, "w") as f:
                f.write(render_random_html(
                    serial, pools, index=os.path.basename(out), audit=audit))
            random_pages.append((serial, target, len(pools)))
    links = dict((serial, os.path.relpath(target, out_dir))
                 for serial, target, _ in random_pages)
    html = render_html(counters, sites, args.cpm_per_usvh, args.title, shots,
                       randoms=links)
