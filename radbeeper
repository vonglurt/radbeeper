# PORT: replaced by src/main.rs :: big_number() -- same name, same block-glyph digits
def big_number(text, on="\u2588", off=" "):
    """`text` as six rows of block glyphs. Unknown characters are skipped."""
    rows = [""] * BIG_ROWS
    for ch in text:
        glyph = BIG_DIGITS.get(ch)
        if glyph is None:
            continue
        for r in range(BIG_ROWS):
            rows[r] += "".join(on if bit == "1" else off for bit in glyph[r])
            rows[r] += off
    return rows


# PORT: replaced by src/analysis.rs :: bar_rows() -- same name, same eight levels a row
def bar_rows(samples, width, height=4):
    """The counts as a column chart `height` terminal rows tall.

    One row of block glyphs has eight levels in it, which is enough to say
    "something happened" and not enough to say how much. Four rows have
    thirty-two, which is the difference between seeing a spike and seeing that
    it was three times the background -- and it costs three lines of a screen
    that has them going spare.
    """
    tail = samples[-width:]
    if not tail:
        return [""] * height
    peak = max(c for _t, c in tail) or 1
    rows = []
    for r in range(height):
        floor = (height - 1 - r) * 8       # row 0 is the top of the chart
        line = []
        for _t, c in tail:
            units = int(round(c * height * 8.0 / peak))
            line.append(SPARK[min(8, max(0, units - floor))])
        rows.append("".join(line))
    return rows


# PORT: replaced by src/main.rs :: watch() -- the same panels, drawn with escape codes rather than curses
def run_curses(counter, w, args):
    import curses

    ladder = SpectrumLadder()
    pool = Entropy(args.entropy_bits)
    # NOT `line`: the bar-drawing loops below both use that as their loop
    # variable, and a name bound in this closure is one name for all of it.
    shown = {"hex": None, "at": None, "suspect": False}

    def draw(stdscr):
        curses.curs_set(0)
        stdscr.nodelay(True)
        use_colour = curses.has_colors()
        if use_colour:
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_GREEN, -1)
            curses.init_pair(2, curses.COLOR_YELLOW, -1)
            curses.init_pair(3, curses.COLOR_RED, -1)
            curses.init_pair(4, curses.COLOR_CYAN, -1)

        pairs = {"calm": 1, "raised": 2, "high": 3}

        def band(cpm):
            if not use_colour or cpm is None:
                return curses.A_NORMAL
            return curses.color_pair(pairs[level(cpm)]) | curses.A_BOLD

        for when, counts in counter.samples():
            w.add(when, counts)
            ladder.add(counts)
            spec = ladder.best()
            pool.add(when, counts)
            stdscr.erase()
            h, width = stdscr.getmaxyx()
            footer = {"text": "", "attr": curses.A_DIM}
            # NO TITLE ROW. The program's own name is the one thing on this
            # screen nobody needs telling -- they typed it -- and it was
            # costing a row the readout can use. The firmware moves in beside
            # the port, where somebody looks for it anyway.
            head = ("%s @ %s baud   %s   serial %s"
                    % (counter.path, counter.baud or "n/a",
                       counter.version, counter.serial_no))
            stdscr.addnstr(0, 0, head, width - 1, curses.A_DIM)
            row = 2
            for span in w.spans:
                cpm = w.average(span)
                usvh = w.usvh(span, args.cpm_per_usvh)
                label = "%5ds" % span
                if cpm is None:
                    left = int(span - w.elapsed()) + 1
                    stdscr.addnstr(row, 0, "%s   filling, %ds to go"
                                   % (label, max(0, left)), width - 1,
                                   curses.A_DIM)
                else:
                    stdscr.addnstr(row, 0, label, width - 1, curses.A_DIM)
                    stdscr.addnstr(row, 7, "%8.1f CPM" % cpm, width - 8,
                                   band(cpm))
                    stdscr.addnstr(row, 23, "%8.3f uSv/h" % usvh, width - 24,
                                   curses.A_NORMAL)
                row += 1
            row += 1
            stdscr.addnstr(row, 0, "now  %d counts this second" % counts,
                           width - 1, curses.A_BOLD)
            row += 1
            stdscr.addnstr(row, 0, "run  %d counts in %ds"
                           % (w.total, int(w.elapsed())), width - 1)

            # THE NUMBER, BIG, to the right of the small ones. The 30s
            # window is the one to put in six-row digits: 3s is too jumpy to
            # read as a headline and 300s is too slow to react to anything
            # somebody is doing with their hands.
            headline = w.average(30) if 30 in w.spans else w.average(w.spans[-1])
            digits = big_number("--" if headline is None
                                else "%.0f" % headline)
            wide = max(len(d) for d in digits)
            # Clear of the header, which is on the row the digits start on.
            # This was a constant 54 and the header outgrew it: a serial is
            # fourteen characters and the firmware moved up beside the port,
            # so the digits were landing on top of the counter's own name.
            # Measured, not guessed, and it cannot drift again.
            left = len(head) + 3
            if width > left + wide + 6 and h > BIG_ROWS:
                attr = band(headline) if headline is not None else curses.A_DIM
                for i, line in enumerate(digits):
                    stdscr.addnstr(i, left, line, width - left - 1, attr)
            row += 2
            # Two rows of air: the chart is the only picture on the screen
            # and it was sitting straight on top of the arithmetic. It was
            # three; the third is the clock's, at the bottom.
            row += 2
            if width > 20:
                # COLOURED BY WHAT IT MEANS, not by what it is. A column is
                # one second, so its count times sixty is the rate it implies,
                # and it takes the same calm/raised/high bands as the numbers
                # above -- a spike that would read red up there reads red down
                # here, without anybody converting in their head.
                tail = w.samples[-(width - 1):]
                tall = max(1, min(5, h - row - 11))
                for i, line in enumerate(bar_rows(w.samples, width - 1, tall)):
                    for x, glyph in enumerate(line):
                        if glyph == " ":
                            continue
                        c = tail[x][1] if x < len(tail) else 0
                        pair = (curses.color_pair(
                            {"calm": 4, "raised": 2, "high": 3}[level(c * 60.0)])
                            if use_colour else 0)
                        try:
                            stdscr.addstr(row + i, x, glyph, pair)
                        except curses.error:
                            break
                row += tall
            row += 1

            # The spectrum, which is flat when everything is well. See the
            # Spectrum class for why that is the useful answer.
            if h > row + 5 and width > 30:
                rel = spec.relative()
                if not rel:
                    footer["text"] = ("spectrum   accumulating, %ds to the "
                                      "first window of %d"
                                      % (spec.wait(), spec.window))
                else:
                    cols = spectrum_columns(rel, width - 1)
                    top, where = spec.loudest()
                    z = spec.sigma(top)
                    secs = spec.period(where)
                    # Against what chance gives the LARGEST of this many bins,
                    # not against what it gives one of them.
                    luck = spec.chance_max()
                    if top < luck * 1.25:
                        verdict = ("flat -- arrivals look random, as decay "
                                   "should")
                        attr = curses.A_DIM
                    else:
                        verdict = ("peak at %.0fs, %.1fx the mean (chance "
                                   "gives %.1fx), %.1f sigma"
                                   % (secs, top, luck, z))
                        attr = ((curses.color_pair(2 if top < luck * 2 else 3)
                                 | curses.A_BOLD) if use_colour
                                else curses.A_BOLD)
                    # THE WORDS GO TO THE FOOT OF THE SCREEN. A sentence
                    # sitting between the chart and its own axis broke the
                    # picture in half, and the picture is the part being read
                    # at a glance; the sentence is what you go and look at
                    # once something in the picture catches your eye.
                    footer["text"] = ("spectrum   %s (%d windows)"
                                      % (verdict, spec.runs))
                    footer["attr"] = attr
                    # Four rows here too, and coloured by significance rather
                    # than by height: a bin twice the mean is exciting after
                    # fifty windows and meaningless after two, and the colour
                    # is the only place that difference can show.
                    tall = max(1, min(5, h - row - 4))
                    fake = [(0.0, v) for v in cols]
                    for i, line in enumerate(bar_rows(fake, len(cols), tall)):
                        for x, glyph in enumerate(line):
                            if glyph == " ":
                                continue
                            v = cols[x]
                            pair = (curses.color_pair(
                                3 if v >= luck * 2 else
                                2 if v >= luck * 1.25 else 4)
                                if use_colour else 0)
                            if use_colour and v >= luck * 2:
                                pair |= curses.A_BOLD
                            try:
                                stdscr.addstr(row + i, x, glyph, pair)
                            except curses.error:
                                break
                    row += tall
                    if h > row + 1:
                        # Bin 1 is the slowest thing the window can see and the
                        # last bin the fastest, so the axis runs long to short.
                        lo = "%ds" % spec.window
                        hi = "2s"
                        gap = max(1, (width - 1) - len(lo) - len(hi))
                        stdscr.addnstr(row, 0, lo + " " * gap + hi,
                                       width - 1, curses.A_DIM)
            # The rotating line: 256 bits of decay, when the pool has earned
            # them. See the Entropy class for what "earned" is doing there.
            if h > row + 2 and width > 84:
                row += 1
                if pool.ready():
                    top, _where = spec.loudest()
                    suspect = bool(top and top >= spec.chance_max() * 1.25)
                    text, record = pool.draw()
                    shown["hex"], shown["suspect"] = text, suspect
                    shown["at"] = time.strftime("%H:%M:%S")
                    try:
                        write_entropy(record, counter.serial_no, suspect)
                    except OSError:
                        pass
                if shown["hex"]:
                    stdscr.addnstr(row, 0, "random   " + group_hex(shown["hex"]),
                                   width - 1,
                                   curses.color_pair(4) if use_colour else 0)
                    if h > row + 2:
                        # THE COUNTDOWN KEEPS RUNNING. The line stayed on
                        # screen with no indication of whether the next one
                        # was a minute away or eight, which is the one thing
                        # somebody watching it wants to know.
                        note = ("%d bits from decay at %s   %s%s"
                                % (args.entropy_bits, shown["at"],
                                   pool_status(pool),
                                   "  -- SPECTRUM NOT FLAT, treat as suspect"
                                   if shown["suspect"] else ""))
                        stdscr.addnstr(row + 1, 9, note, width - 10,
                                       (curses.color_pair(3) | curses.A_BOLD)
                                       if (shown["suspect"] and use_colour)
                                       else curses.A_DIM)
                else:
                    stdscr.addnstr(row, 0, "random   " + pool_status(pool),
                                   width - 1, curses.A_DIM)
                # The time now, two rows under the random line whether or not
                # it has a note yet, so it does not jump when the first line
                # arrives -- and so a screenshot says when it was taken.
                if row + 2 < h - 2:
                    stdscr.addnstr(row + 2, 0, "clock", width - 1, curses.A_DIM)
                    stdscr.addnstr(row + 2, 9, time.strftime("%Y-%m-%d %H:%M:%S"),
                                   width - 10)
            if footer["text"] and h > row + 1:
                stdscr.addnstr(h - 2, 0, footer["text"], width - 1,
                               footer["attr"])
            if h > row + 1:
                stdscr.addnstr(h - 1, 0, "q to quit", width - 1, curses.A_DIM)
            stdscr.refresh()
            ch = stdscr.getch()
            if ch in (ord("q"), ord("Q"), 27):
                return
            if args.duration and w.elapsed() >= args.duration:
                return

    curses.wrapper(draw)


# PORT: replaced by src/main.rs :: watch(), reached from the "watch" arm of main()
def cmd_watch(args):
    try:
        counter = open_counter(args)
    except NotFound as e:
        print("no counter: %s" % e.reason, file=sys.stderr)
        if e.detail:
            for line in e.detail.splitlines():
                print("    %s" % line, file=sys.stderr)
        return 1
    w = Windows(args.spans)
    try:
        if args.plain or not sys.stdout.isatty():
            run_plain(counter, w, args)
        else:
            run_curses(counter, w, args)
    except KeyboardInterrupt:
        pass
    finally:
        counter.close()
    return 0


# ----------------------------------------------------------------- history ---
#
# THE FORMAT IS BEST-EFFORT AND THE RAW BYTES ARE ALWAYS KEPT. GQ's history
# encoding is a byte stream with 0x55 0xAA escape sequences, it has changed
# between firmware revisions, and the only authority is a PDF that disagrees
# with some shipped units. So the download writes the flash image to disk
# first and decodes second: a decoder that mis-reads a marker costs a bad CSV,
# never the data, and a better decoder can be run over the same image later.
# This is that better decoder, and the image it was written against is the
# reason the rule earns its keep.
#
#   55 AA 00 YY MM DD HH MM SS          a timestamp -- NINE bytes, no mode
#   55 AA 01                            follows every timestamp; three bytes
#   55 AA 02 <len> <ascii...>           a note typed on the device
#   FF                                  unwritten flash
#   anything else                       one count, one byte
#
# THE DATETIME RECORD IS NINE BYTES. GQ's document describes ten, the last a
# save-mode byte, and this program believed it. It is not there on GMC-320Re
# 4.26: measured over a 16 KiB image on 4 Sep 2026, all 85 datetime records
# were followed immediately by 0x55 -- the first byte of the next marker.
# Reading a tenth byte swallowed that 0x55, left 0xAA to be decoded as an
# ordinary sample, and so INVENTED a count of 170 every three minutes. Nine
# bytes, and the save interval is measured rather than believed.
#
# AND 55 AA 01 CARRIES NO PAYLOAD. GQ's document calls it a two-byte count,
# for a second whose count did not fit in a byte, and reading it that way
# produced 1,701 readings between 256 and 21,930 counts per second on a tube
# that saturates three orders of magnitude below that. Three things settle it,
# measured over a full 1 MiB image:
#
#   1. All 4,709 of them sit exactly nine bytes after a timestamp. Not one
#      appears anywhere else, so it is structural and not data-driven -- a
#      real escape would follow the data, not the clock.
#   2. Its two "payload" bytes have the same distribution as ordinary count
#      bytes: 64% zero, 21% one, 7% two. Counts, not a big-endian pair.
#   3. Read as a marker, a three-minute stretch holds 180 samples over 181
#      seconds rather than 179 -- nearer a true one per second, which is what
#      the counter claims to be doing.
#
# So it is three bytes and the two that follow it are samples. 0x55AA itself
# turned up as a "count" of 21,930 under the old reading, which is the marker
# eating itself and was the thread worth pulling.
# PORT: replaced by src/history.rs :: raw() returning RawIter -- same name, same three record shapes
def _history_raw(blob):
    """Yield (offset, kind, value) for each record: mark, count or note.

    One pass, nothing kept. A 1 MiB image holds about a million samples and
    this program runs on machines with 512 MB, so no stage of reading history
    is allowed to build a list with one entry per sample.
    """
    i, n = 0, len(blob)
    while i < n:
        b = blob[i]
        if b == 0x55 and i + 3 <= n and blob[i + 1] == 0xAA:
            kind = blob[i + 2]
            if kind == 0x00 and i + 9 <= n:
                yy, mm, dd, hh, mi, ss = blob[i + 3:i + 9]
                # The fields are range-checked BEFORE mktime, because mktime
                # normalises rather than refuses: month 99 day 99 is not an
                # error to it, it is 2034. Corrupt or half-erased flash throws
                # up 55 AA 00 followed by rubbish, and a mark accepted from
                # that would place every sample after it in the wrong decade.
                if (1 <= mm <= 12 and 1 <= dd <= 31 and hh <= 23
                        and mi <= 59 and ss <= 60):
                    try:
                        when = time.mktime((2000 + yy, mm, dd, hh, mi, ss,
                                            0, 1, -1))
                    except (ValueError, OverflowError):
                        when = None
                else:
                    when = None
                if when is not None:
                    yield i, "mark", when
                i += 9
                continue
            if kind == 0x01 and i + 3 <= n:
                i += 3
                continue
            if kind == 0x02 and i + 4 <= n:
                ln = blob[i + 3]
                yield i, "note", blob[i + 4:i + 4 + ln].decode("ascii", "replace")
                i += 4 + ln
                continue
        if b == 0xFF:
            i += 1
            continue
        yield i, "count", b
        i += 1


# PORT: replaced by src/history.rs :: marks() -- same name, same wrapped-ring search
def history_marks(blob):
    """[[offset, unix time, samples before the next mark]] -- one per timestamp.

    Small: a timestamp every three minutes is about 5,400 of these in a full
    1 MiB image, against a million samples. Everything else about the recording
    is derived from this list.
    """
    marks = []
    since = 0
    for off, kind, val in _history_raw(blob):
        if kind == "mark":
            if marks:
                marks[-1][2] = since
            marks.append([off, val, 0])
            since = 0
        elif kind == "count":
            since += 1
    if marks:
        marks[-1][2] = since
    return marks


# PORT: replaced by src/history.rs :: sample_intervals() -- same name, same measured spacing
def sample_intervals(marks):
    """Seconds per sample for each stretch between two timestamps.

    THE INTERVAL IS MEASURED, NOT ASSUMED, and that is the whole reason this
    function exists. The counter saves one sample per "second" and its second
    is not one of ours: on the unit this was written against, 179 samples land
    between marks 181 seconds apart -- 1.011 s each, which is 39 seconds of
    drift an hour. Placing an hour-old sample by assuming 1.000 would put it
    most of a minute from where it belongs, and backfilled rows would land in
    the wrong slots.

    BUT A MEASUREMENT IS NOT ALWAYS OF WHAT IT LOOKS LIKE. A stretch whose
    mark is followed four hours later did not record one sample every eighty
    seconds -- the counter was switched off in between, and its 179 samples
    belong in the three minutes after its own mark with a four-hour hole after
    them. So the measurements are taken, their median is the recording's real
    rate, and any stretch more than a factor of two either side of that is
    given the median instead of its own reading. The hole then survives as a
    hole, which is what it was.

    An image with only one timestamp measures nothing at all and says so with
    None, rather than assuming a second and quietly being wrong.
    """
    raw = [None] * len(marks)
    for j in range(len(marks) - 1):
        span = marks[j + 1][1] - marks[j][1]
        n = marks[j][2]
        if n > 0 and span > 0:
            raw[j] = span / float(n)
    good = sorted(x for x in raw if x is not None)
    if not good:
        return raw
    median = good[len(good) // 2]
    return [median if (x is None or not 0.5 * median <= x <= 2.0 * median)
            else x for x in raw]


# PORT: replaced by src/history.rs :: records() -- same name
def history_records(blob):
    """Yield (offset, when, dt, count, note) for every record in an image.

    `when` is a unix time on THE COUNTER'S OWN CLOCK -- correcting that to this
    machine's is a separate step, because it is a separate error with a
    separate cause. Records before the first timestamp carry when=None: a
    partial read of the middle of the flash cannot honestly place them.
    """
    marks = history_marks(blob)
    dts = sample_intervals(marks)
    at = dict((m[0], j) for j, m in enumerate(marks))
    base = dt = None
    k = 0
    for off, kind, val in _history_raw(blob):
        if kind == "mark":
            j = at.get(off)
            base, dt = val, (dts[j] if j is not None else None)
            k = 0
            yield off, val, dt, None, ""
        elif kind == "count":
            if base is None or dt is None:
                yield off, None, None, val, ""
            else:
                yield off, base + k * dt, dt, val, ""
                k += 1
        else:
            yield off, base, dt, None, val


# PORT: replaced by src/history.rs :: samples() -- same name, same clock offset
def history_samples(blob, offset=0.0):
    """Yield (unix time, count, seconds this sample covers).

    `offset` is added to every timestamp: see measure_clock_offset.
    """
    for _off, when, dt, count, _note in history_records(blob):
        if when is not None and count is not None:
            yield when + offset, count, dt


# PORT: replaced by src/main.rs :: measure_clock_offset() -- same name
def measure_clock_offset(counter):
    """Seconds to add to the counter's timestamps to land on this clock.

    The counter's RTC is not this machine's. On the unit here it reads about
    half an hour behind, which is six hundred slots at the default row
    spacing: backfilling without this correction would file four hours of
    recording under the wrong four hours.

    TIMED TO THE COUNTER'S TICK, NOT READ ONCE. The answer is in whole
    seconds, so a single reading is uncertain by the whole of one -- 0.85 s
    on the unit here. It is asked again, back to back, until the second
    changes: the tick fell after the counter took the last old answer and
    before it sent the first new one, which is two round trips wide. If the
    second never turns over it falls back to the one reading, centred.

    It assumes the offset held over the whole recording, which is the best a
    single measurement can do -- and is why the number is always printed
    rather than quietly applied.
    """
    def reading():
        sent = time.time()
        text = counter.datetime()
        got = time.time()
        if not text:
            return None
        try:
            return time.mktime(time.strptime(text, "%Y-%m-%d %H:%M:%S")), sent, got
        except ValueError:
            return None

    r = reading()
    if r is None:
        return None
    first, before, got = r
    fallback = (before + got) / 2.0 - (first + 0.5)
    give_up = got + 2.5
    while time.time() < give_up:
        r = reading()
        if r is None:
            return fallback
        theirs, sent, got = r
        if theirs != first:
            return (before + got) / 2.0 - theirs
        before = sent
    return fallback


# PORT: replaced by src/main.rs :: first_mark_time() -- same name
def first_mark_time(counter, address, probe):
    """The time of the first timestamp in a probe read at `address`."""
    chunk = counter.read_history(address, probe) or b""
    for _off, kind, val in _history_raw(chunk):
        if kind == "mark":
            return val
    return None


# PORT: replaced by src/main.rs :: find_history_end() -- same name, same probe
def find_history_end(counter, size, probe=2048):
    """(newest byte address, whether the flash has wrapped).

    Pulling a full megabyte over 115200 baud takes ten minutes and the rows a
    backfill wants are the NEWEST, so the first job is to find where the newest
    ones are. There are two shapes of flash and they need different searches.

    NOT YET FULL. Writing runs forward from zero and the rest is 0xFF. Eleven
    probes bisect for where the 0xFF starts, and that is the end.

    ALREADY WRAPPED, which is what the counter on the bench turned out to be
    doing -- 1 MiB of ring with no unwritten byte anywhere in it. The newest
    sample is immediately BEFORE the write pointer and the oldest immediately
    after, so the flash reads as one long climb in time with exactly one step
    backwards in it, and that step is the pointer. Timestamps are monotonic
    either side of it, so it bisects: any address whose first mark is older
    than the mark at zero lies past the pointer.

    Getting this wrong is not a small error. Reading the physical tail of a
    wrapped ring hands back the OLDEST hours in the flash while claiming they
    are the newest, and a backfill would file last week under this afternoon.
    """
    tail = counter.read_history(max(0, size - probe), probe) or b""
    if not any(c != 0xFF for c in tail):
        lo, hi = 0, size
        if not any(c != 0xFF for c in counter.read_history(0, probe) or b""):
            return 0, False
        while hi - lo > probe:
            mid = (lo + hi) // 2
            chunk = counter.read_history(mid, probe) or b""
            if any(c != 0xFF for c in chunk):
                lo = mid
            else:
                hi = mid
        # Bisection lands within a probe of the truth; the last step reads
        # that window and takes the exact byte, so the tail read does not
        # carry a kilobyte of 0xFF with it.
        window = counter.read_history(lo, probe * 2) or b""
        last = -1
        for j, c in enumerate(window):
            if c != 0xFF:
                last = j
        return (lo + last + 1) if last >= 0 else lo, False

    start = first_mark_time(counter, 0, probe)
    if start is None:
        return size, True          # no marks to steer by; take it as it lies
    lo, hi = 0, size               # lo is newer-or-equal, hi is past the step
    while hi - lo > probe:
        mid = (lo + hi) // 2
        seen = first_mark_time(counter, mid, probe)
        if seen is None or seen >= start:
            lo = mid
        else:
            hi = mid
    # And exactly where, inside that window, time steps back. Overshooting
    # costs a kilobyte of last week's samples on the front of the read --
    # harmless, since they sort into their own slots, but it is a wrong
    # answer to a question with a right one.
    window = counter.read_history(lo, probe * 2) or b""
    for off, kind, val in _history_raw(window):
        if kind == "mark" and val < start:
            return lo + off, True
    return lo + probe, True


