        return 0
    sites = ensure_site(serial)
    mine = [r for r in sites if r[0] == serial]
    now = site_at(serial, time.time(), sites)
    print("counter %s" % serial)
    print("now     %s" % (now[2] if now else
                          "nowhere recorded -- radbeeper site --name ..."))
    where = fix_text(now) if now else ""
    if where:
        print("fix     %s" % where)
    if len(mine) > 1:
        print("history")
        for row in mine:
            when, name = row[1], row[2]
            here = fix_text(row)
            print("  %s  %s%s"
                  % ("from the start  " if when <= 0 else
                     time.strftime("%Y-%m-%d %H:%M", time.localtime(when)),
                     name, ("  [" + here + "]") if here else ""))
    return 0


def _precision_scale(places):
    """Roughly what one unit in the last place spans on the ground."""
    metres = 111320.0 / (10.0 ** places)
    if metres >= 1000:
        return "%g km" % round(metres / 1000.0, 1)
    if metres >= 1:
        return "%g m" % round(metres)
    return "%g cm" % round(metres * 100)


# ------------------------------------------------------------------ export ---
#
# WHY THIS IS IN HERE AND NOT A SEPARATE SCRIPT. The point of the export is
# that somebody can fork the repository, drop their own logs in, and have a
# page. A separate script is a second thing to install, a second thing to keep
# in step with the row format, and the first thing to rot when a column is
# added. It reads the same files the same way the rest of the program writes
# them, so a format change breaks it here rather than silently on somebody
# else's web page.
#
# The page has no javascript and fetches nothing. A search box and a pager
# over a table somebody scrolls once are two hundred kilobytes of library to
# reimplement what the browser already does with ctrl-F and a scrollbar; and
# the full record is a tab-separated file that opens in anything, so the page
# links to it rather than pretending to page through it. The chart is SVG the
# generator draws itself, for the same reason there is no pyserial.
LOG_GLOB = "cpm-"
HOMEPAGE = "https://github.com/vonglurt/radbeeper"
TAGLINE = "A GQ GMC Geiger-Muller counter on the desk"


# PORT: replaced by src/log.rs :: files() -- same name, same sort
def log_files(directory=None):
    """[(serial, path)] for every dated log in a directory, oldest name first."""
    d = directory or state_dir()
    out = []
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return out
    for name in names:
        if not name.startswith(LOG_GLOB) or not name.endswith(".tsv"):
            continue
        stem = name[len(LOG_GLOB):-len(".tsv")]
        # cpm-<serial>-YYYY-MM.tsv, and a serial may contain no dash we care
        # about: split from the right, where the date is.
        bits = stem.rsplit("-", 2)
        if len(bits) != 3:
            continue
        out.append((bits[0], os.path.join(d, name)))
    return out


# The cells the page reads, in the order it reads them: counts at 2, seconds
# at 3, the first peak at 7, source at 10, site at 11 -- the three-window
# header, which is what the page was written against.
PAGE_COLUMNS = ["time", "cps", "counts", "seconds", "cpm_3", "cpm_30",
                "cpm_300", "peak_3", "peak_30", "peak_300", "src", "site"]


# PORT: replaced by src/export.rs :: read_rows() -- same name, the same by-name re-columning into PAGE_COLUMNS
def read_rows(path):
    """Yield (when, cells) for a dated log, re-columned BY NAME.

    IT WAS POSITIONAL, and every log written since the fourth window was added
    was misread by it: cpm_3000 came out under "Peak 3s", peak_300 under
    "Source" and peak_3000 under "Site". Each row is read under the last
    header above it, and a file with no header is taken to be the
    three-window layout the positions were written for.
    """
    names = PAGE_COLUMNS
    try:
        with open(path) as f:
            for line in f:
                line = line.rstrip("\n")
                if line.startswith("#"):
                    found = log_columns(line)
                    if found:
                        names = found
                    continue
                when = row_time(line)
                if when is not None:
                    yield when, align_row(line.split("\t"), names,
                                          PAGE_COLUMNS)
    except IOError:
        return


# PORT: replaced by src/export.rs :: now() (renamed) -- same SOURCE_DATE_EPOCH, same wall-clock fallback
def export_now():
    """When the pages say they were generated.

    ADDED FOR THE DIFFERENTIAL TEST, and the only thing that was. Both pages
    print the time they were built, so two exports of the same logs a minute
    apart differ -- and so would the Python's and the Rust's. SOURCE_DATE_EPOCH
    is the reproducible-builds convention; both implementations honour it, and
    nothing sets it unless asked.
    """
    try:
        return float(os.environ["SOURCE_DATE_EPOCH"])
    except (KeyError, ValueError):
        return time.time()


# PORT: replaced by src/export.rs :: summarise() -- same name, same totals, hours and days, returning Counter structs
def summarise(directory=None, cpm_per_usvh=DEFAULT_CPM_PER_USVH):
    """Per counter: the totals, the daily rollup, and the last rows seen.

    The daily rollup is counts over seconds, not a mean of the per-row CPMs:
    rows are not all the same length -- a service stopped mid-interval writes a
    short one -- and averaging averages would weight a four-second row like a
    thirty-second one.
    """
    counters = {}
    for serial, path in log_files(directory):
        c = counters.setdefault(serial, {
            "serial": serial, "rows": 0, "counts": 0, "seconds": 0.0,
            "first": None, "last": None, "peak": None, "days": {},
            "hours": {}, "latest": [], "sites": set()})
        for when, cells in read_rows(path):
            try:
                counts = int(cells[2])
                seconds = float(cells[3])
            except (IndexError, ValueError):
                continue
            peak = None
            if len(cells) > 7 and cells[7]:
                try:
                    peak = float(cells[7])
                except ValueError:
                    peak = None
            c["rows"] += 1
            c["counts"] += counts
            c["seconds"] += seconds
            c["first"] = when if c["first"] is None else min(c["first"], when)
            c["last"] = when if c["last"] is None else max(c["last"], when)
            if peak is not None and (c["peak"] is None or peak > c["peak"]):
                c["peak"] = peak
            if len(cells) > 11 and cells[11]:
                c["sites"].add(cells[11])
            # An hour is the plot's resolution: eleven days of thirty-second
            # rows is 28,000 points, which is more ink than the page is wide
            # and nothing a reader can see. 270 is a line.
            hour = int(when // 3600)
            h = c["hours"].setdefault(hour, {"counts": 0, "seconds": 0.0,
                                             "peak": None})
            h["counts"] += counts
            h["seconds"] += seconds
            if peak is not None and (h["peak"] is None or peak > h["peak"]):
                h["peak"] = peak
            day = time.strftime("%Y-%m-%d", time.localtime(when))
            d = c["days"].setdefault(day, {"rows": 0, "counts": 0,
                                           "seconds": 0.0, "peak": None})
            d["rows"] += 1
            d["counts"] += counts
            d["seconds"] += seconds
            if peak is not None and (d["peak"] is None or peak > d["peak"]):
                d["peak"] = peak
            c["latest"].append((when, cells))
    for c in counters.values():
        c["latest"].sort(key=lambda r: r[0])
        # Sixty rows is half an hour and about four screens. The rest of the
        # record is one link away as the file it already lives in, which loads
        # faster than any amount of javascript pretending to page through it.
        c["latest"] = c["latest"][-60:]
        c["cpm"] = (c["counts"] * 60.0 / c["seconds"]) if c["seconds"] else 0.0
        c["usvh"] = c["cpm"] / cpm_per_usvh if cpm_per_usvh else 0.0
    return counters


# PORT: replaced by src/export.rs :: nice_ceiling() -- same name
def nice_ceiling(value):
    """A round number at or above value, for an axis somebody can read."""
    if value <= 0:
        return 1.0
    import math
    power = 10 ** math.floor(math.log10(value))
    for step in (1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10):
        if value <= step * power:
            return step * power
    return 10 * power


# PORT: replaced by src/export.rs :: hour_series() -- same name
def hour_series(counter):
    """[(unix time, mean CPM, peak CPM or None)] per hour, in order."""
    out = []
    for hour in sorted(counter["hours"]):
        h = counter["hours"][hour]
        if not h["seconds"]:
            continue
        out.append((hour * 3600.0, h["counts"] * 60.0 / h["seconds"],
                    h["peak"]))
    return out


# PORT: replaced by src/export.rs :: together() -- same counts-weighted mean, same sigma, same worst-pair z
def together(counters, cpm_per_usvh=DEFAULT_CPM_PER_USVH):
    """What two or more tubes in one room measured, taken together.

    COUNTS-WEIGHTED, WHICH IS THE ONLY DEFENSIBLE MEAN. Adding the counts and
    adding the seconds gives the rate of the pair; averaging the two rates
    instead would give a tube that recorded for an hour the same say as one
    that recorded for a week. Two counters do NOT double the dose -- what
    doubles is the evidence, and the whole benefit lands in `sigma`.

    None unless at least two tubes have counts.
    """
    import math
    live = [(serial, c) for serial, c in sorted(counters.items())
            if c["seconds"] > 0 and c["counts"] > 0]
    if len(live) < 2:
        return None
    counts = sum(c["counts"] for _s, c in live)
    seconds = sum(c["seconds"] for _s, c in live)
    cpm = counts * 60.0 / seconds

    def rate_of(c):
        if c["seconds"] <= 0 or c["counts"] <= 0:
            return None
        r = c["counts"] / c["seconds"]
        return r, r / math.sqrt(c["counts"])

    # DO THEY AGREE? Two identical tubes in one room should, to within a
    # couple of sigma; a difference that keeps growing is the tubes being
    # different, not the room being interesting, and it is the one question
    # a second instrument exists to answer.
    worst = None
    for i in range(len(live)):
        for j in range(i + 1, len(live)):
            a, b = rate_of(live[i][1]), rate_of(live[j][1])
            if not a or not b:
                continue
            sd = math.sqrt(a[1] * a[1] + b[1] * b[1])
            if sd <= 0:
                continue
            z = abs((a[0] - b[0]) / sd)
            if worst is None or z > worst[0]:
                worst = (z, live[i][0], live[j][0])
    return {
        "tubes": len(live),
        "counts": counts,
        "seconds": seconds,
        "cpm": cpm,
        "usvh": cpm / cpm_per_usvh if cpm_per_usvh else 0.0,
        "sigma": cpm / math.sqrt(counts) if counts > 0 else 0.0,
        "worst": worst,
    }


# PORT: replaced by src/export.rs :: agreement() -- the same three verdicts at the same two thresholds
def agreement(z):
    """How to read a disagreement, in the words it deserves."""
    if z < 2.0:
        return "they agree"
    if z < 4.0:
        return "they differ -- watch it"
    return "they disagree -- not the same measurement"


# PORT: replaced by src/export.rs :: svg_overlay() -- the same axes, the same four colours, the same coordinates to the tenth
def svg_overlay(series, width=1120, height=560, pad_l=52, pad_b=26, pad_t=12,
                pad_r=10):
    """Every tube's hourly mean on one pair of axes, in one colour each.

    THE POINT IS THE TRACKING, NOT THE VALUES. Two counters watching one room
    should draw the same shape; where they part company is where something is
    wrong with a tube, a cable or a pass-through, and no table of averages
    shows that as fast as two lines that stop being parallel.

    NO PEAK LINE AND NO MINOR GRID, unlike svg_plot: this chart is read by
    comparing shapes, and four peak traces over four mean traces is eight
    lines nobody can follow.
    """
    import math
    live = [(serial, s) for serial, s in series if len(s) >= 2]
    if len(live) < 2:
        return ""
    values = [m for _serial, s in live for _t, m, _p in s if m > 0]
    if not values:
        return ""
    lo = 10.0 ** math.floor(math.log10(min(values)))
    hi = 10.0 ** math.ceil(math.log10(max(values)))
    if hi <= lo:
        hi = lo * 10.0
    span_y = math.log10(hi) - math.log10(lo)
    t0 = min(s[0][0] for _serial, s in live)
    t1 = max(s[-1][0] for _serial, s in live)
    span = (t1 - t0) or 1.0
    iw = width - pad_l - pad_r
    ih = height - pad_t - pad_b
    X = lambda t: pad_l + iw * (t - t0) / span
    Y = lambda v: pad_t + ih * (1.0 - (math.log10(max(v, lo)) - math.log10(lo))
                                / span_y)
    step = 3600 * 1.5

    out = ['<svg class="plot" viewBox="0 0 %d %d" width="100%%" '
           'preserveAspectRatio="xMidYMid meet" role="img" '
           'aria-label="counts per minute over time, every counter">'
           % (width, height)]
    decade = lo
    while decade <= hi * 1.0001:
        y = Y(decade)
        out.append('<line class="grid" x1="%d" y1="%.1f" x2="%d" y2="%.1f"/>'
                   % (pad_l, y, width - pad_r, y))
        out.append('<text class="ylab" x="%d" y="%.1f">%s</text>'
                   % (pad_l - 8, y + 4, "{:,}".format(int(decade))))
        decade *= 10.0
    day = 86400.0
    t = t0 - (t0 % day) + day
    while t < t1:
        x = X(t)
        out.append('<line class="grid" x1="%.1f" y1="%d" x2="%.1f" y2="%d"/>'
                   % (x, pad_t, x, pad_t + ih))
        out.append('<text class="xlab" x="%.1f" y="%d">%s</text>'
                   % (x, height - 8,
                      time.strftime("%b %-d", time.localtime(t))))
        t += day
    for i, (serial, points) in enumerate(live):
        d, last = [], None
        for when, mean, _peak in points:
            letter = "M" if last is None or when - last > step else "L"
            d.append("%s%.1f %.1f" % (letter, X(when), Y(mean)))
            last = when
        out.append('<path class="tube t%d" d="%s"/>' % (i % 4, " ".join(d)))
        out.append('<text class="key t%d" x="%d" y="%d">%s</text>'
                   % (i % 4, pad_l + 8, pad_t + 16 + 15 * i, esc(serial)))
    out.append('<text class="ycap" x="%d" y="%d">CPM, log</text>'
               % (pad_l - 44, pad_t + 10))
    out.append("</svg>")
    return "".join(out)


# PORT: replaced by src/export.rs :: svg_plot() -- same name, same log axis and broken line, the same coordinates to the tenth
def svg_plot(series, width=1120, height=1200, pad_l=52, pad_b=26, pad_t=12,
             pad_r=10):
    """An inline SVG line chart. No plotting library, for the same reason
    there is no pyserial: this has to build on a machine with no network, and
    a line and some axes are not worth a dependency.

    THE LINE BREAKS OVER A GAP rather than running across it. An hour the
    counter was not recording is not an hour of zero and it is not a straight
    line between the readings either side; drawing one would invent the very
    thing the log format goes to such lengths not to invent.

    THE AXIS IS LOGARITHMIC because the data is. Background sits near 40 CPM
    and the highest three-second peak in a quiet fortnight is two hundred
    times that; on a linear axis the background -- the line somebody is
    actually here to read -- is a flat smear along the bottom one percent,
    and the whole plot is one spike. Decades are also how anybody who works
    with this quantity already thinks about it.
    """
    if len(series) < 2:
        return ""
    import math
    xs = [t for t, _m, _p in series]
    values = [m for _t, m, _p in series if m > 0]
    values += [p for _t, _m, p in series if p]
    if not values:
        return ""
    lo = 10.0 ** math.floor(math.log10(min(values)))
    hi = 10.0 ** math.ceil(math.log10(max(values)))
    if hi <= lo:
        hi = lo * 10.0
    span_y = math.log10(hi) - math.log10(lo)
    t0, t1 = xs[0], xs[-1]
    span = (t1 - t0) or 1.0
    iw = width - pad_l - pad_r
    ih = height - pad_t - pad_b
    X = lambda t: pad_l + iw * (t - t0) / span
    Y = lambda v: pad_t + ih * (1.0 - (math.log10(max(v, lo)) - math.log10(lo))
                                / span_y)
    # An hour and a half between points means an hour went unrecorded.
    step = 3600 * 1.5

    def path(values):
        d, pen = [], False
        last = None
        for t, v in values:
            if v is None:
                pen = False
                last = t
                continue
            if not pen or (last is not None and t - last > step):
                d.append("M%.1f %.1f" % (X(t), Y(v)))
            else:
                d.append("L%.1f %.1f" % (X(t), Y(v)))
            pen = True
            last = t
        return " ".join(d)

    out = ['<svg class="plot" viewBox="0 0 %d %d" width="100%%" '
           'preserveAspectRatio="xMidYMid meet" role="img" '
           'aria-label="counts per minute over time">' % (width, height)]
    # y grid: one line per decade, with the halfway marks left unlabelled so
    # the eye can still judge where a value sits inside one.
    decade = lo
    while decade <= hi * 1.0001:
        y = Y(decade)
        out.append('<line class="grid" x1="%d" y1="%.1f" x2="%d" y2="%.1f"/>'
                   % (pad_l, y, width - pad_r, y))
        out.append('<text class="ylab" x="%d" y="%.1f">%s</text>'
                   % (pad_l - 8, y + 4, "{:,}".format(int(decade))))
        for minor in (2, 5):
            v = decade * minor
            if v < hi:
                ym = Y(v)
                out.append('<line class="grid minor" x1="%d" y1="%.1f" '
                           'x2="%d" y2="%.1f"/>' % (pad_l, ym, width - pad_r,
                                                    ym))
        decade *= 10
    # x ticks at local midnight
    day = 86400
    first = t0 - (t0 % day) + day
    t = first
    while t < t1:
        x = X(t)
        out.append('<line class="grid" x1="%.1f" y1="%d" x2="%.1f" y2="%d"/>'
                   % (x, pad_t, x, pad_t + ih))
        out.append('<text class="xlab" x="%.1f" y="%d">%s</text>'
                   % (x, height - 8, time.strftime("%b %-d", time.localtime(t))))
        t += day
    out.append('<path class="peak" d="%s"/>'
               % path([(t, p) for t, _m, p in series]))
    out.append('<path class="mean" d="%s"/>'
               % path([(t, m) for t, m, _p in series]))
    out.append('<text class="ycap" x="%d" y="%d">CPM, log</text>'
               % (pad_l - 44, pad_t + 10))
    out.append("</svg>")
    return "".join(out)


